{
  "name": "cadence-clinical-workspace",
  "version": "1.0.0",
  "description": "Cadence Clinical Research Software: an operating system for clinical research built on one clinical kernel.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:all": "pnpm -r test && node scripts/run-cli.js test",
    "check-docs-drift": "node scripts/run-cli.js validate-architecture-drift",
    "lint": "node scripts/run-cli.js validate-path-patterns && pnpm -r lint",
    "format": "pnpm -r format && pnpm exec prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,css,md,yaml,yml}\"",
    "fix": "node scripts/run-cli.js fix",
    "cadence": "node scripts/run-cli.js",
    "doctor": "node scripts/run-cli.js doctor",
    "db:reset": "node scripts/run-cli.js db reset",
    "check": "node scripts/run-cli.js check",
    "verify": "pnpm check && pnpm test",
    "rtm": "node scripts/run-cli.js generate-rtm --validate",
    "sync-gxp": "node scripts/run-cli.js gxp sync",
    "setup:dev": "dotnet restore Cadence.sln",
    "ports:check": "node scripts/run-cli.js check-ports",
    "openapi:export": "node scripts/run-cli.js sync-openapi-spec",
    "adr:new": "node scripts/run-cli.js scaffold adr",
    "adr:create": "node scripts/run-cli.js scaffold adr",
    "adrs:check": "node scripts/run-cli.js check adrs",
    "adrs:fix": "node scripts/run-cli.js fix",
    "build": "pnpm --filter ui build && pnpm --filter web build",
    "build:demo": "pnpm --filter ui build && pnpm --filter web build:demo",
    "docs:dev": "node scripts/build-docs.js --prepare-only && vitepress dev docs",
    "docs:build": "node scripts/build-docs.js",
    "build:docs": "node scripts/build-docs.js",
    "prepare": "node scripts/setup-git-hooks.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fderuiter/cadence-clinical.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/fderuiter/cadence-clinical/issues"
  },
  "homepage": "https://github.com/fderuiter/cadence-clinical#readme",
  "private": true,
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "mermaid": "^11.17.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
