{
  "name": "cadence-clinical-workspace",
  "version": "1.0.0",
  "description": "Cadence Clinical Research Software: an operating system for clinical research built on one clinical kernel.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:all": "pnpm -r test && dotnet run --project packages/cli/src/Cadence.Cli.csproj -- test",
    "check-docs-drift": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- validate-architecture-drift",
    "lint": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- validate-path-patterns && pnpm -r lint",
    "format": "pnpm -r format && pnpm exec prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,css,md,yaml,yml}\"",
    "fix": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- fix",
    "cadence": "dotnet run --project packages/cli/src/Cadence.Cli.csproj --",
    "doctor": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- doctor",
    "db:reset": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- db reset",
    "db:seed": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- db seed",
    "db:status": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- db status",
    "check": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- check",
    "verify": "pnpm check && pnpm test",
    "rtm": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- generate-rtm --validate",
    "sync-gxp": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- gxp sync",
    "setup:dev": "dotnet restore Cadence.sln",
    "ports:check": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- check-ports",
    "openapi:export": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- sync-openapi-spec",
    "adr:new": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- scaffold adr",
    "adr:create": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- scaffold adr",
    "adrs:check": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- check adrs",
    "adrs:fix": "dotnet run --project packages/cli/src/Cadence.Cli.csproj -- fix",
    "build": "pnpm --filter ui build && pnpm --filter web build",
    "build:demo": "pnpm --filter ui build && pnpm --filter web build:demo",
    "docs:dev": "node scripts/build-docs.js --prepare-only && vitepress dev docs",
    "docs:build": "node scripts/build-docs.js",
    "build:docs": "node scripts/build-docs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fderuiter/cadence-clinical.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/fderuiter/cadence-clinical/issues"
  },
  "homepage": "https://github.com/fderuiter/cadence-clinical#readme",
  "private": true,
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.2",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
