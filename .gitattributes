# Deterministic GxP verification artifacts and security baselines ensure clean standard merging without union corruptions

# Binary Assets
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# Custom Git Merge Driver Mappings for Metadata and Documentation
.secrets.baseline merge=custom-metadata-driver
*.secrets.baseline merge=custom-metadata-driver
*.md merge=custom-metadata-driver
.cadence/snapshots/*.tar.gz merge=custom-metadata-driver

# Checksum-verified standards seed content: never normalise line endings (Seed/manifest.json pins each file's SHA-256)
packages/kernel/src/Cadence.Standards/Seed/*.json -text
