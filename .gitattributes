# Binary Assets
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# No custom merge drivers (ADR-2532): GitHub ignores them when it decides whether a PR can merge, and the
# generated GxP reports are kept conflict-free by never committing them on feature branches. Never use merge=union.

# Checksum-verified standards seed content: never normalise line endings (Seed/manifest.json pins each file's SHA-256)
packages/kernel/src/Cadence.Standards/Seed/*.json -text
packages/kernel/src/Cadence.Standards/Blocks/*.json -text

# Machine-generated artifacts (collapse in GitHub PR diffs and exclude from Linguist language stats)
pnpm-lock.yaml linguist-generated=true
docs/openapi/*.json linguist-generated=true
apps/web/src/api/generated/*.ts linguist-generated=true
apps/web/src/api/types.ts linguist-generated=true
apps/web/src/canvas/generated/*.ts linguist-generated=true
docs/api/*.md linguist-generated=true
docs/schema/*.md linguist-generated=true
docs/SDLC/** linguist-generated=true
**/Migrations/*.Designer.cs linguist-generated=true
**/*ModelSnapshot.cs linguist-generated=true
