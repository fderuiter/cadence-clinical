  <PropertyGroup>
    <RootNamespace>Cadence.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MIG-SUBJ-023: Microsoft.AspNetCore.OpenApi's XML-comment source generator flows transitively into
         this project via the Cadence.Apps.Execution project reference (that package is not PrivateAssets
         there), but the InterceptorsNamespaces opt-in its own package props would normally inject applies
         only to a project referencing it directly, so this project needs the same opt-in explicitly,
         exactly as the compiler's own CS9137 error names it. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

