# Top-most EditorConfig file for Cadence Clinical Research Software (.NET 10 / C# 14)
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

# Organize Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:error

# Namespace declaration style (C# 10+ file-scoped namespaces)
csharp_style_namespace_declarations = file_scoped:error

# Language preferences
csharp_prefer_simple_using_statement = true:error
csharp_style_pattern_matching = true:suggestion
csharp_prefer_primary_constructors = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_null_propagation = true:error
csharp_style_prefer_null_coalescing_operator = true:error

# Modifier preferences
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion

# Formatting rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Naming conventions
dotnet_naming_rule.interface_should_be_begins_with_i.severity = error
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = error
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

[*.{json,yaml,yml,xml,md}]
indent_size = 2


# EF Core scaffolded migrations (dotnet ef migrations add). They are generated code that runs once per database, so
# the per-call allocation rules do not apply to their constant column arrays (CA1861, CA1825), and their class names
# are the migration names (CA1711, for example KernelActivityStream).
[**/Migrations/*.cs]
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1825.severity = none
dotnet_diagnostic.CA1861.severity = none

# Tests. Test method names follow Method_Scenario_ExpectedResult, so they contain underscores (CA1707). A test runs
# its arrange data once, so constant array arguments (CA1861) cost nothing, and a test declares the interface it
# exercises rather than the concrete type (CA1859).
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
