<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core & OpenTelemetry -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetServicingVersion)" />
    <!-- Gateway OIDC bearer-token validation against Keycloak (#4761). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(DotNetServicingVersion)" />
    <!-- WebApplicationFactory and Aspire require the same Microsoft.Extensions servicing versions. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <!-- OpenTelemetry.Instrumentation.Runtime skipped 1.20.2 and jumped to 1.21.0 (.NET 11); pin to $(OpenTelemetryVersion) (1.20.1). -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(DotNetServicingVersion)" />

    <!-- Aspire AppHost & Orchestration (keep all Aspire.Hosting.* packages aligned with Aspire.AppHost.Sdk in Cadence.AppHost.csproj) -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireHostingVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireHostingVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireHostingVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireHostingVersion)" />

    <!-- Persistence & Database Drivers -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetServicingVersion)" />

    <!-- Asynchronous Messaging & Transactional Outbox -->
    <PackageVersion Include="MassTransit" Version="$(MassTransitVersion)" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="$(MassTransitVersion)" />

    <!-- CLI & Developer Experience -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <!-- Validation & Security -->
    <!-- Stay on Fluid.Core 2.41.x (security-patched 2.x) until FluidTemplateRenderer migrates to Fluid 3.x APIs (#5948). -->
    <PackageVersion Include="Fluid.Core" Version="2.41.2" />
    <PackageVersion Include="FluentValidation" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetServicingVersion)" />

    <!-- Testing Infrastructure -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="1.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.5" />

    <!-- AI model port and providers (ADR-2630; keep Microsoft.Extensions.AI.* aligned on 10.x for net10.0) -->
    <PackageVersion Include="Anthropic" Version="13.12.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="$(DotNetAiVersion)" />
    <PackageVersion Include="Anthropic.Aws" Version="1.0.2" />
    <PackageVersion Include="Anthropic.Bedrock" Version="1.0.6" />
    <PackageVersion Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageVersion Include="Anthropic.Vertex" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="$(DotNetAiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(DotNetAiVersion)" />

    <!-- AI agent tools (ADR-2633): the provider-neutral function abstraction and the official MCP C# SDK. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- Media, Storage & Antivirus Integrations -->
    <PackageVersion Include="fo-dicom" Version="5.2.6" />
    <PackageVersion Include="FFMpegCore" Version="6.0.0" />
    <PackageVersion Include="nClam" Version="7.0.0" />
    <!-- Stay on AWSSDK.S3 4.0.x while targeting net10.0; AWSSDK.Core >= 4.1.0 depends on System.IO.Hashing 11.0.0. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />

    <!-- Analyzers & Code Quality -->
    <!-- Stay on Microsoft.CodeAnalysis.NetAnalyzers 9.0.0 while targeting net10.0; 11.0.100 targets .NET 11 (#5949, ADR-2233, ADR-2527). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
    <!-- Stay on SonarAnalyzer.CSharp 10.6.0.109712 until S8969/S5332/S6444 rule additions in 10.7+ are migrated across HL7/FHIR canonical URIs and test suites. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.6.0.109712" />
    <!-- #4784 K-TIME-3: bans direct wall-clock reads (see BannedSymbols.txt); referenced solution-wide in root Directory.Build.props. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
