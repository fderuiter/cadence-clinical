{
  "threshold": 0,
  "minLines": 15,
  "minTokens": 60,
  "path": [
    "apps",
    "packages"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/*.spec.js",
    "**/*.test.js",
    "**/*_test.py",
    "**/tests/**",
    "**/verification/**",
    "**/scratch/**",
    "**/prototype/**",
    "**/.venv/**",
    "**/dist/**",
    "**/build/**",
    "**/pnpm-lock.yaml",
    "**/uv.lock"
  ],
  "reporters": [
    "console"
  ],
  "absolute": true
}
