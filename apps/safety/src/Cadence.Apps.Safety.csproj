<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Cadence.Apps.Safety</RootNamespace>
    <Description>Cadence Clinical Safety Service (.NET 10 / C# 14 Minimal APIs).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\compliance\src\Cadence.Compliance.csproj" />
    <ProjectReference Include="..\..\..\packages\engine_core\src\Cadence.Core.Domain.csproj" />
    <ProjectReference Include="..\..\..\packages\security\src\Cadence.Security.csproj" />
    <ProjectReference Include="..\..\..\packages\telemetry\src\Cadence.Telemetry.csproj" />
    <ProjectReference Include="..\..\..\packages\database\src\Cadence.Database.csproj" />
    <ProjectReference Include="..\..\..\packages\kernel\src\Cadence.Kernel.Abstractions\Cadence.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\packages\templating\src\Cadence.Templating.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Templates\**\*.liquid" Link="Templates\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The ICH E2B(R3) ICSR schema (HL7 v3 XSDs from the ICH implementation package) the rendered ICSR is validated against. -->
    <EmbeddedResource Include="..\Schemas\ich-e2b-r3\**\*.xsd" Link="Schemas\ich-e2b-r3\%(RecursiveDir)%(Filename)%(Extension)" LogicalName="IchE2bR3/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
