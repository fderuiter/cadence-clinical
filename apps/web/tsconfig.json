{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "ui": ["../../packages/ui/index.d.ts"],
      "ui/theme": ["../../packages/ui/theme.d.ts"],
      "ui/testing": ["../../packages/ui/mockGateway.js"],
      "ui/vitest": ["../../packages/ui/accessibility-matcher.d.ts"],
      "demo-fixtures": ["../../packages/demo-fixtures/src/index.d.ts"],
      "demo-fixtures/runtime": [
        "../../packages/demo-fixtures/src/runtime.d.ts"
      ],
      "demo-fixtures/mocks": ["../../packages/demo-fixtures/src/mocks.d.ts"],
      "usdm-schemas": ["../../packages/usdm-schemas/src/index.ts"]
    },
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "playwright.config.ts",
    "playwright.correction-check.config.ts"
  ]
}
