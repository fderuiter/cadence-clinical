  "description": "",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm --filter ui build",
    "pretest": "pnpm --filter ui build",
    "dev": "vite",
    "build": "vite build --base=/cadence-clinical/ && node ../../scripts/build-docs.js",
    "build:demo": "vite build --mode demo --base=/cadence-clinical/ && node ../../scripts/build-docs.js",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "node ../../scripts/check_duplicate_identifiers.js && tsc --noEmit",
    "lint": "node ../../scripts/check_duplicate_identifiers.js && eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
