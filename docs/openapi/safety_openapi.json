  "components": {
    "schemas": {
      "Safety_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_DsurApproveRequest": {
        "required": [
          "signerUserId",
          "signingReason",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "signerUserId": {
            "type": [
              "null",
              "string"
            ]
          },
          "signingReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_DsurCompileRequest": {
        "required": [
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "compoundName": {
            "type": "string"
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectEnrollments": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SubjectEnrollmentRecord"
            }
          },
          "safetyCases": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SafetyCaseIcsrInput"
            }
          }
        }
      },
      "Safety_DsurLineListingItem": {
        "required": [
          "caseId",
          "subjectId",
          "studyId",
          "treatmentArm",
          "dosageCohort",
          "age",
          "sex",
          "aeTerm",
          "meddraPt",
          "meddraSoc",
          "onsetDate",
          "resolutionDate",
          "isSerious",
          "isFatal",
          "isAesi",
          "aesiCategory",
          "causality",
          "expectedness",
          "actionTaken"
        ],
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "treatmentArm": {
            "type": "string"
          },
          "dosageCohort": {
            "type": [
              "null",
              "string"
            ]
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sex": {
            "type": [
              "null",
              "string"
            ]
          },
          "aeTerm": {
            "type": "string"
          },
          "meddraPt": {
            "type": "string"
          },
          "meddraSoc": {
            "type": "string"
          },
          "onsetDate": {
            "type": "string",
            "format": "date-time"
          },
          "resolutionDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isSerious": {
            "type": "boolean"
          },
          "isFatal": {
            "type": "boolean"
          },
          "isAesi": {
            "type": "boolean"
          },
          "aesiCategory": {
            "type": [
              "null",
              "string"
            ]
          },
          "causality": {
            "type": "string"
          },
          "expectedness": {
            "type": "string"
          },
          "actionTaken": {
            "type": "string"
          }
        }
      },
      "Safety_DsurReportPayload": {
        "required": [
          "reportId",
          "reportType",
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "exposureMetrics",
          "totalSubjectExposure",
          "totalSaes",
          "totalFatalCases",
          "totalSusars",
          "totalAesi",
          "lineListings",
          "summaryTabulations",
          "rsiComparisonSummary",
          "signalSummary"
        ],
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string"
          },
          "reportType": {
            "type": "string"
          },
          "compoundName": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "exposureMetrics": {
            "$ref": "#/components/schemas/Safety_SubjectExposureMetrics"
          },
          "totalSubjectExposure": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalSaes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalFatalCases": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalSusars": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalAesi": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lineListings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_DsurLineListingItem"
            }
          },
          "summaryTabulations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_DsurSummaryTabulationRow"
            }
          },
          "rsiComparisonSummary": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "signalSummary": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Safety_DsurSnapshotDetail": {
        "required": [
          "id",
          "reportId",
          "reportType",
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "status",
          "payload",
          "payloadDigestSha256",
          "versionIndex",
          "createdAt",
          "createdBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
