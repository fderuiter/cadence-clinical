{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Safety | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Clinical Safety \u0026 Pharmacovigilance health probe.",
        "operationId": "SafetyHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Returns Safety operational status.",
        "operationId": "SafetyStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/icsr/render": {
      "post": {
        "tags": [
          "IcsrTemplateEndpoints"
        ],
        "summary": "Renders an ICSR E2B(R3) safety report as Liquid XML.",
        "operationId": "RenderIcsrReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_IcsrReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/compile": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Compiles an aggregate DSUR periodic safety report with patient-years exposure and MedDRA cross-tabulation.",
        "operationId": "CompileDsurReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurCompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/{id}/approve": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Applies a 21 CFR Part 11 PKCS#7 e-signature block via GxPSigner and locks the DSUR record.",
        "operationId": "ApproveDsurReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Safety_DsurApproveRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/{id}": {
      "put": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Updates a draft DSUR periodic safety report record. Returns 409 Conflict if LOCKED.",
        "operationId": "UpdateDsurReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Retrieves a DSUR periodic safety report record by identifier.",
        "operationId": "GetDsurReportById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Lists all DSUR periodic safety report records.",
        "operationId": "ListDsurReports",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/{id}/snapshots": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Retrieves all versioned point-in-time snapshot summaries for a given DSUR report.",
        "operationId": "GetDsurReportSnapshots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Safety_DsurSnapshotSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/snapshots/{snapshotId}": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Retrieves an immutable point-in-time DSUR snapshot record by snapshot ID.",
        "operationId": "GetDsurSnapshotById",
        "parameters": [
          {
            "name": "snapshotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_DsurSnapshotDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/snapshots/{snapshotId}/verify": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Cryptographically verifies SHA-256 payload digest, Part 11 e-signature, and GxP Merkle audit chain.",
        "operationId": "VerifyDsurSnapshot",
        "parameters": [
          {
            "name": "snapshotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_DsurSnapshotVerificationResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
