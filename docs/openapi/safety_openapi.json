{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Safety | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Clinical Safety \u0026 Pharmacovigilance health probe.",
        "operationId": "SafetyHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Returns Safety operational status.",
        "operationId": "SafetyStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/icsr/render": {
      "post": {
        "tags": [
          "IcsrTemplateEndpoints"
        ],
        "summary": "Renders an ICSR E2B(R3) safety report as Liquid XML.",
        "operationId": "RenderIcsrReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_IcsrReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Safety_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrHeader": {
        "required": [
          "messageId",
          "senderOrganization",
          "receiverOrganization",
          "transmissionDate"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string"
          },
          "senderOrganization": {
            "type": "string"
          },
          "receiverOrganization": {
            "type": "string"
          },
          "transmissionDate": {
            "type": "string"
          },
          "messageType": {
            "type": "string",
            "default": "ichicsr"
          }
        }
      },
      "Safety_IcsrMeddraCoding": {
        "required": [
          "lltCode",
          "lltName",
          "ptCode",
          "ptName",
          "hltCode",
          "hltName",
          "hlgtCode",
          "hlgtName",
          "socCode",
          "socName"
        ],
        "type": "object",
        "properties": {
          "lltCode": {
            "type": "string"
          },
          "lltName": {
            "type": "string"
          },
          "ptCode": {
            "type": "string"
          },
          "ptName": {
            "type": "string"
          },
          "hltCode": {
            "type": "string"
          },
          "hltName": {
            "type": "string"
          },
          "hlgtCode": {
            "type": "string"
          },
          "hlgtName": {
            "type": "string"
          },
          "socCode": {
            "type": "string"
          },
          "socName": {
            "type": "string"
          },
          "primarySocFlag": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": "string",
            "default": "1.0"
          }
        }
      },
      "Safety_IcsrPatient": {
        "required": [
          "patientId",
          "sex"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "sex": {
            "type": "string"
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ageUnit": {
            "type": [
              "null",
              "string"
            ]
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrReaction": {
        "required": [
          "reactionTerm"
        ],
        "type": "object",
        "properties": {
          "reactionTerm": {
            "type": "string"
          },
          "meddraCoding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Safety_IcsrMeddraCoding"
              }
            ]
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "outcome": {
            "type": [
              "null",
              "string"
            ]
          },
          "seriousnessDeath": {
            "type": "string",
            "default": "0"
          },
          "seriousnessLifeThreatening": {
            "type": "string",
            "default": "0"
          },
          "seriousnessHospitalization": {
            "type": "string",
            "default": "0"
          },
          "seriousnessDisability": {
            "type": "string",
            "default": "0"
          },
          "seriousnessCongenitalAnomaly": {
            "type": "string",
            "default": "0"
          },
          "seriousnessOtherMedicallyImportant": {
            "type": "string",
            "default": "0"
          }
        }
      },
      "Safety_IcsrReport": {
        "required": [
          "header",
          "reportIdentifiers",
          "patient",
          "reactions",
          "suspectDrugs"
        ],
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Safety_IcsrHeader"
          },
          "reportIdentifiers": {
            "$ref": "#/components/schemas/Safety_IcsrReportIdentifiers"
          },
          "patient": {
            "$ref": "#/components/schemas/Safety_IcsrPatient"
          },
          "reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_IcsrReaction"
            }
          },
          "suspectDrugs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_IcsrSuspectDrug"
            }
          },
          "versionIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 1
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrReportIdentifiers": {
        "required": [
          "worldwideUniqueCaseId"
        ],
        "type": "object",
        "properties": {
          "worldwideUniqueCaseId": {
            "type": "string"
          },
          "localReportId": {
            "type": [
              "null",
              "string"
            ]
          },
          "firstSenderType": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrSuspectDrug": {
        "required": [
          "drugName"
        ],
        "type": "object",
        "properties": {
          "drugName": {
            "type": "string"
          },
          "activeSubstanceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "dosageText": {
            "type": [
              "null",
              "string"
            ]
          },
          "routeOfAdministration": {
            "type": [
              "null",
              "string"
            ]
          },
          "actionTakenWithDrug": {
            "type": [
              "null",
              "string"
            ]
          },
          "drugRole": {
            "type": "string",
            "default": "suspect"
          }
        }
      },
      "Safety_ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Safety"
    },
    {
      "name": "IcsrTemplateEndpoints"
    }
  ]
}
