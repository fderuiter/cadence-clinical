        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyCaseICSRResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/export-jobs": {
      "get": {
        "summary": "List Export Jobs",
        "description": "List all safety export jobs.",
        "operationId": "list_export_jobs_api_v1_safety_export_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SafetyExportJobResponse"
                  },
                  "type": "array",
                  "title": "Response List Export Jobs Api V1 Safety Export Jobs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Export Job",
        "description": "Create a new safety ICSR export job.",
        "operationId": "create_export_job_api_v1_safety_export_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SafetyExportJobCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyExportJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/export-jobs/{id}": {
      "get": {
        "summary": "Get Export Job",
        "description": "Retrieve details of a specific export job by ID.",
        "operationId": "get_export_job_api_v1_safety_export_jobs__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyExportJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/audit-logs": {
      "get": {
        "summary": "List Safety Audit Logs",
        "description": "Retrieve safety audit logs in descending chronological order.",
        "operationId": "list_safety_audit_logs_api_v1_safety_audit_logs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SafetyAuditLogResponse"
                  },
                  "type": "array",
                  "title": "Response List Safety Audit Logs Api V1 Safety Audit Logs Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/export": {
      "post": {
        "summary": "Export Safety Case",
        "description": "Expose validated E2B export and outbound safety/PV transmission.\nAccepts SAE/ICSR data, renders and validates E2B XML, pseudonymizes patient PII\nfollowing the HMAC approach, transmits to configured safety gateway,\npersists a SafetyExportJob, and writes GxP-compliant audit events.",
        "operationId": "export_safety_case_api_v1_safety_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ICSRDataExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyExportJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/reconciliation/runs": {
      "get": {
        "summary": "List Reconciliation Runs",
        "description": "List all safety reconciliation runs.",
        "operationId": "list_reconciliation_runs_api_v1_safety_reconciliation_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SAEReconciliationRunResponse"
                  },
                  "type": "array",
                  "title": "Response List Reconciliation Runs Api V1 Safety Reconciliation Runs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Trigger Sae Reconciliation",
        "description": "Triggers deterministic SAE reconciliation, comparing EDC observations\nwith external safety PV database, and persisting results safely (no direct patient PII).",
        "operationId": "trigger_sae_reconciliation_api_v1_safety_reconciliation_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SAEReconciliationRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAEReconciliationRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/reconciliation/jobs": {
      "post": {
        "summary": "Trigger Sae Reconciliation Job",
        "description": "Triggers asynchronous SAE reconciliation job. Returns HTTP 202 Accepted.\n\nGated to sponsor_medical_monitor or safety_reviewer roles per GxP RBAC policy.",
        "operationId": "trigger_sae_reconciliation_job_api_v1_safety_reconciliation_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SAEReconciliationJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAEReconciliationJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Reconciliation Jobs",
        "description": "List safety reconciliation jobs with pagination.\n\nArgs:\n    limit: Maximum number of jobs to return (default 50).\n    offset: Number of jobs to skip (default 0).",
        "operationId": "list_reconciliation_jobs_api_v1_safety_reconciliation_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SAEReconciliationJobResponse"
                  },
                  "title": "Response List Reconciliation Jobs Api V1 Safety Reconciliation Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/reconciliation/jobs/{job_id}": {
      "get": {
        "summary": "Get Reconciliation Job",
        "description": "Retrieve a specific safety reconciliation job by ID (polling).\n\nArgs:\n    job_id: The UUID of the reconciliation job to retrieve.",
        "operationId": "get_reconciliation_job_api_v1_safety_reconciliation_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAEReconciliationJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/reconciliation/runs/{id}": {
      "get": {
        "summary": "Get Reconciliation Run",
        "description": "Retrieve a specific safety reconciliation run.",
        "operationId": "get_reconciliation_run_api_v1_safety_reconciliation_runs__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAEReconciliationRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ICSRDataExportRequest": {
        "properties": {
          "job_name": {
            "type": "string",
            "title": "Job Name",
            "description": "The descriptive name of the export job"
          },
          "icsr": {
            "$ref": "#/components/schemas/IndividualCaseSafetyReport",
            "description": "The E2B ICSR report data"
          }
        },
        "type": "object",
        "required": [
          "job_name",
          "icsr"
        ],
        "title": "ICSRDataExportRequest"
      },
      "ICSRHeader": {
        "properties": {
          "sender_organization": {
            "type": "string",
            "title": "Sender Organization",
            "description": "Sender organization identifier"
          },
          "receiver_organization": {
            "type": "string",
            "title": "Receiver Organization",
            "description": "Receiver organization identifier"
          },
          "message_type": {
            "type": "string",
            "title": "Message Type",
            "description": "Message type",
            "default": "ICHICSR"
          },
          "transmission_date": {
            "type": "string",
            "title": "Transmission Date",
            "description": "Transmission date/time (DTC format)"
          },
          "message_id": {
            "type": "string",
            "title": "Message Id",
            "description": "Unique message ID"
          }
        },
        "type": "object",
        "required": [
          "sender_organization",
          "receiver_organization",
          "transmission_date",
          "message_id"
        ],
        "title": "ICSRHeader",
        "description": "ICSR transmission header details according to ICH E2B(R3)."
      },
      "ICSRPatient": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id",
            "description": "Patient identifier / subject key"
          },
          "sex": {
            "type": "string",
            "title": "Sex",
            "description": "Gender code (normalizes to 'M', 'F', 'U')"
          },
          "age": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age",
            "description": "Age of the patient"
          },
          "age_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Unit",
            "description": "Age unit (e.g. YEAR, MONTH, DAY)"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date",
            "description": "Date of birth"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "sex"
        ],
        "title": "ICSRPatient",
        "description": "ICSR patient characteristics block."
      },
      "ICSRReactionEvent": {
        "properties": {
          "reaction_term": {
            "type": "string",
            "title": "Reaction Term",
            "description": "Reaction or event term as reported"
          },
          "meddra_coding": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MedDRACoding"
              },
              {
                "type": "null"
              }
            ],
            "description": "MedDRA coding details"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "Start date of reaction"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date",
            "description": "End date of reaction"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome",
            "description": "Outcome of reaction (e.g. RECOVERED, RESOLVING, FATAL)"
          },
          "seriousness_death": {
            "type": "string",
            "title": "Seriousness Death",
            "description": "Results in death ('Y' or 'N')",
            "default": "N"
          },
          "seriousness_life_threatening": {
            "type": "string",
            "title": "Seriousness Life Threatening",
            "description": "Is life-threatening ('Y' or 'N')",
            "default": "N"
          },
          "seriousness_hospitalization": {
            "type": "string",
            "title": "Seriousness Hospitalization",
            "description": "Requires/prolongs hospitalization ('Y' or 'N')",
            "default": "N"
          },
          "seriousness_disability": {
            "type": "string",
            "title": "Seriousness Disability",
            "description": "Results in persistent/significant disability ('Y' or 'N')",
            "default": "N"
          },
          "seriousness_congenital_anomaly": {
            "type": "string",
            "title": "Seriousness Congenital Anomaly",
            "description": "Results in congenital anomaly/birth defect ('Y' or 'N')",
            "default": "N"
          },
          "seriousness_other_medically_important": {
            "type": "string",
            "title": "Seriousness Other Medically Important",
            "description": "Other medically important condition ('Y' or 'N')",
            "default": "N"
          }
        },
        "type": "object",
        "required": [
          "reaction_term"
        ],
        "title": "ICSRReactionEvent",
        "description": "ICSR reaction/event block with MedDRA coding."
      },
      "ICSRReportIdentifiers": {
        "properties": {
          "worldwide_unique_case_id": {
            "type": "string",
            "title": "Worldwide Unique Case Id",
            "description": "Worldwide unique case ID (e.g., ICH worldwide unique ID)"
          },
          "local_report_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Report Id",
            "description": "Local report identifier"
          },
          "first_sender_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Sender Type",
            "description": "Type of first sender"
          }
        },
        "type": "object",
        "required": [
          "worldwide_unique_case_id"
        ],
        "title": "ICSRReportIdentifiers",
        "description": "ICSR report-level identification details."
      },
      "ICSRSuspectDrug": {
        "properties": {
          "drug_name": {
            "type": "string",
            "title": "Drug Name",
            "description": "Name of suspect drug"
          },
          "active_substance_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Substance Name",
            "description": "Active substance name"
          },
          "dosage_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dosage Text",
            "description": "Dosage and administration text description"
          },
          "route_of_administration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Of Administration",
            "description": "Route of administration"
          },
          "action_taken_with_drug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Taken With Drug",
            "description": "Action taken with the drug"
          },
          "drug_role": {
            "type": "string",
            "title": "Drug Role",
            "description": "Role of the drug (e.g. SUSPECT, CONCOMITANT, INTERACTING)",
            "default": "SUSPECT"
          }
        },
        "type": "object",
        "required": [
          "drug_name"
        ],
        "title": "ICSRSuspectDrug",
        "description": "ICSR suspect drug block."
      },
      "IndividualCaseSafetyReport": {
        "properties": {
          "version_index": {
            "type": "integer",
            "title": "Version Index",
            "description": "Version of this record (must be >= 1)",
            "default": 1
          },
          "reason_for_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason For Change",
            "description": "Reason for change in follow-up version"
          },
          "header": {
            "$ref": "#/components/schemas/ICSRHeader",
            "description": "ICSR message header"
          },
          "report_identifiers": {
            "$ref": "#/components/schemas/ICSRReportIdentifiers",
            "description": "ICSR report identifiers"
          },
          "patient": {
            "$ref": "#/components/schemas/ICSRPatient",
            "description": "Patient details"
          },
          "reactions": {
            "items": {
              "$ref": "#/components/schemas/ICSRReactionEvent"
            },
            "type": "array",
            "title": "Reactions",
            "description": "List of reactions/events"
          },
          "suspect_drugs": {
            "items": {
              "$ref": "#/components/schemas/ICSRSuspectDrug"
            },
            "type": "array",
            "title": "Suspect Drugs",
            "description": "List of suspect drugs"
          }
        },
        "type": "object",
        "required": [
          "header",
          "report_identifiers",
          "patient"
        ],
        "title": "IndividualCaseSafetyReport",
        "description": "Root Individual Case Safety Report (ICSR) according to ICH E2B(R3)."
      },
