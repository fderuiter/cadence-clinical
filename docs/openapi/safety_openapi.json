{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Safety | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Clinical Safety \u0026 Pharmacovigilance health probe.",
        "operationId": "SafetyHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Safety"
        ],
        "summary": "Returns Safety operational status.",
        "operationId": "SafetyStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/icsr/render": {
      "post": {
        "tags": [
          "IcsrTemplateEndpoints"
        ],
        "summary": "Renders an ICSR E2B(R3) safety report as Liquid XML; a report missing a mandatory element is refused with 400 naming each one.",
        "operationId": "RenderIcsrReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_IcsrReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/compile": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Compiles an aggregate DSUR periodic safety report with patient-years exposure and MedDRA cross-tabulation.",
        "operationId": "CompileDsurReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurCompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/{id}/approve": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Signs and locks a DSUR as the verified caller: needs safety_report:approve, a step-up signature token bound to the report and a reason for change; the compiler cannot approve.",
        "operationId": "ApproveDsurReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Safety_DsurApproveRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur/{id}": {
      "put": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Updates a draft DSUR periodic safety report record. Returns 409 Conflict if LOCKED.",
        "operationId": "UpdateDsurReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Retrieves a DSUR periodic safety report record by identifier.",
        "operationId": "GetDsurReportById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/dsur": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "summary": "Lists all DSUR periodic safety report records.",
        "operationId": "ListDsurReports",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/periodic-reports/compile": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "CompilePeriodicReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurCompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/safety/periodic-reports/{id}/approve": {
      "post": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "ApprovePeriodicReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Safety_DsurApproveRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_PeriodicSafetyReportRecord"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Safety_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/safety/periodic-reports/{id}": {
      "put": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "UpdatePeriodicReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Safety_DsurUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "GetPeriodicReportById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/safety/periodic-reports": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "ListPeriodicReports",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Safety_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_DsurApproveRequest": {
        "required": [
          "signingReason",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "signingReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_DsurCompileRequest": {
        "required": [
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "compoundName": {
            "type": "string"
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectEnrollments": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SubjectEnrollmentRecord"
            }
          },
          "safetyCases": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SafetyCaseIcsrInput"
            }
          }
        }
      },
      "Safety_DsurUpdateRequest": {
        "required": [
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "compoundName": {
            "type": [
              "null",
              "string"
            ]
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "periodStart": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "periodEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Safety_IcsrHeader": {
        "required": [
          "messageId",
          "senderOrganization",
          "receiverOrganization",
          "transmissionDate"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string"
          },
          "senderOrganization": {
            "type": "string"
          },
          "receiverOrganization": {
            "type": "string"
          },
          "transmissionDate": {
            "type": "string"
          },
          "messageType": {
            "type": "string",
            "default": "ichicsr"
          }
        }
      },
      "Safety_IcsrMeddraCoding": {
        "required": [
          "lltCode",
          "lltName",
          "ptCode",
          "ptName",
          "hltCode",
          "hltName",
          "hlgtCode",
          "hlgtName",
          "socCode",
          "socName"
        ],
        "type": "object",
        "properties": {
          "lltCode": {
            "type": "string"
          },
          "lltName": {
            "type": "string"
          },
          "ptCode": {
            "type": "string"
          },
          "ptName": {
            "type": "string"
          },
          "hltCode": {
            "type": "string"
          },
          "hltName": {
            "type": "string"
          },
          "hlgtCode": {
            "type": "string"
          },
          "hlgtName": {
            "type": "string"
          },
          "socCode": {
            "type": "string"
          },
          "socName": {
            "type": "string"
          },
          "primarySocFlag": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": "string",
            "default": "1.0"
          }
        }
      },
      "Safety_IcsrPatient": {
        "required": [
          "patientId",
          "sex"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "sex": {
            "type": "string"
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ageUnit": {
            "type": [
              "null",
              "string"
            ]
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrReaction": {
        "required": [
          "reactionTerm"
        ],
        "type": "object",
        "properties": {
          "reactionTerm": {
            "type": "string"
          },
          "meddraCoding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Safety_IcsrMeddraCoding"
              }
            ]
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "outcome": {
            "type": [
              "null",
              "string"
            ]
          },
          "seriousnessDeath": {
            "type": "string",
            "default": "0"
          },
          "seriousnessLifeThreatening": {
            "type": "string",
            "default": "0"
          },
          "seriousnessHospitalization": {
            "type": "string",
            "default": "0"
          },
          "seriousnessDisability": {
            "type": "string",
            "default": "0"
          },
          "seriousnessCongenitalAnomaly": {
            "type": "string",
            "default": "0"
          },
          "seriousnessOtherMedicallyImportant": {
            "type": "string",
            "default": "0"
          }
        }
      },
      "Safety_IcsrReport": {
        "required": [
          "header",
          "reportIdentifiers",
          "patient",
          "reactions",
          "suspectDrugs"
        ],
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Safety_IcsrHeader"
          },
          "reportIdentifiers": {
            "$ref": "#/components/schemas/Safety_IcsrReportIdentifiers"
          },
          "patient": {
            "$ref": "#/components/schemas/Safety_IcsrPatient"
          },
          "reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_IcsrReaction"
            }
          },
          "suspectDrugs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_IcsrSuspectDrug"
            }
          },
          "versionIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 1
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrReportIdentifiers": {
        "required": [
          "worldwideUniqueCaseId"
        ],
        "type": "object",
        "properties": {
          "worldwideUniqueCaseId": {
            "type": "string"
          },
          "localReportId": {
            "type": [
              "null",
              "string"
            ]
          },
          "firstSenderType": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrSuspectDrug": {
        "required": [
          "drugName"
        ],
        "type": "object",
        "properties": {
          "drugName": {
            "type": "string"
          },
          "activeSubstanceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "dosageText": {
            "type": [
              "null",
              "string"
            ]
          },
          "routeOfAdministration": {
            "type": [
              "null",
              "string"
            ]
          },
          "actionTakenWithDrug": {
            "type": [
              "null",
              "string"
            ]
          },
          "drugRole": {
            "type": "string",
            "default": "suspect"
          }
        }
      },
      "Safety_PeriodicSafetyReportRecord": {
        "required": [
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reportType": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "compoundName": {
            "type": "string"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
