    "/api/v1/safety/periodic-reports": {
      "get": {
        "tags": [
          "DsurEndpoints"
        ],
        "operationId": "ListPeriodicReports",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Safety_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_DsurApproveRequest": {
        "required": [
          "signingReason",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "signingReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          },
          "expectedVersionIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Safety_DsurCompileRequest": {
        "required": [
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "compoundName": {
            "type": "string"
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectEnrollments": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SubjectEnrollmentRecord"
            }
          },
          "safetyCases": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Safety_SafetyCaseIcsrInput"
            }
          }
        }
      },
      "Safety_DsurUpdateRequest": {
        "required": [
          "compoundName",
          "studyId",
          "periodStart",
          "periodEnd",
          "reasonForChange"
        ],
        "type": "object",
        "properties": {
          "compoundName": {
            "type": [
              "null",
              "string"
            ]
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "periodStart": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "periodEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          },
          "expectedVersionIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Safety_HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Safety_IcsrDrug": {
        "required": [
          "drugRole",
          "drugName"
        ],
        "type": "object",
        "properties": {
          "drugRole": {
            "type": "string"
          },
          "drugName": {
            "type": "string"
          },
          "activeSubstanceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "dosageText": {
            "type": [
              "null",
              "string"
            ]
          },
          "routeOfAdministration": {
            "type": [
              "null",
              "string"
            ]
          },
          "actionTakenWithDrug": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrHeader": {
        "required": [
          "batchNumber",
          "batchSenderIdentifier",
          "batchReceiverIdentifier",
          "batchTransmissionDate",
          "messageIdentifier",
          "messageSenderIdentifier",
          "messageReceiverIdentifier"
        ],
        "type": "object",
        "properties": {
          "batchNumber": {
            "type": "string"
          },
          "batchSenderIdentifier": {
            "type": "string"
          },
          "batchReceiverIdentifier": {
            "type": "string"
          },
          "batchTransmissionDate": {
            "type": "string"
          },
          "messageIdentifier": {
            "type": "string"
          },
          "messageSenderIdentifier": {
            "type": "string"
          },
          "messageReceiverIdentifier": {
            "type": "string"
          }
        }
      },
      "Safety_IcsrMeddraCoding": {
        "required": [
          "version",
          "lltCode"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "lltCode": {
            "type": "string"
          }
        }
      },
      "Safety_IcsrOtherCaseIdentifier": {
        "required": [
          "source",
          "caseIdentifier"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "caseIdentifier": {
            "type": "string"
          }
        }
      },
      "Safety_IcsrPatient": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": [
              "null",
              "string"
            ]
          },
          "sex": {
            "type": [
              "null",
              "string"
            ]
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ageUnit": {
            "type": [
              "null",
              "string"
            ]
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Safety_IcsrPrimarySource": {
        "required": [
          "qualification"
        ],
        "type": "object",
        "properties": {
          "qualification": {
            "type": "string"
          },
          "countryCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "primaryForRegulatoryPurposes": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Safety_IcsrReaction": {
        "required": [
          "meddraCoding",
          "outcome"
        ],
        "type": "object",
        "properties": {
          "meddraCoding": {
            "$ref": "#/components/schemas/Safety_IcsrMeddraCoding"
          },
          "outcome": {
            "type": "string"
          },
          "reactionTerm": {
            "type": [
              "null",
              "string"
            ]
          },
          "reactionTermLanguage": {
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "resultsInDeath": {
            "type": "boolean",
            "default": false
          },
          "lifeThreatening": {
            "type": "boolean",
            "default": false
          },
          "causedOrProlongedHospitalisation": {
            "type": "boolean",
            "default": false
          },
          "disablingIncapacitating": {
            "type": "boolean",
            "default": false
          },
          "congenitalAnomalyBirthDefect": {
            "type": "boolean",
            "default": false
          },
          "otherMedicallyImportantCondition": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Safety_IcsrReport": {
        "required": [
          "header",
          "safetyReport",
          "primarySources",
          "sender",
          "patient",
          "reactions",
          "drugs",
          "narrative"
        ],
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Safety_IcsrHeader"
          },
          "safetyReport": {
            "$ref": "#/components/schemas/Safety_IcsrSafetyReport"
          },
          "primarySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Safety_IcsrPrimarySource"
