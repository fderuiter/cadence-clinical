  "components": {
    "schemas": {
      "AcknowledgeNotificationRequest": {
        "properties": {
          "reason_for_change": {
            "type": "string",
            "title": "Reason For Change",
            "description": "21 CFR Part 11 compliant reason for change"
          }
        },
        "type": "object",
        "required": [
          "reason_for_change"
        ],
        "title": "AcknowledgeNotificationRequest"
      },
      "AssignmentComplianceDetail": {
        "properties": {
          "assignment_id": {
            "type": "string",
            "title": "Assignment Id"
          },
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "instrument_name": {
            "type": "string",
            "title": "Instrument Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "title": "End Date"
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "assignment_id",
          "instrument_id",
          "instrument_name",
          "status",
          "due_at",
          "end_date"
        ],
        "title": "AssignmentComplianceDetail"
      },
      "BulkSyncPayload": {
        "properties": {
          "submissions": {
            "items": {
              "$ref": "#/components/schemas/EPROSubmissionPayload"
            },
            "type": "array",
            "title": "Submissions",
            "description": "A list of queued ePRO submissions"
          }
        },
        "type": "object",
        "required": [
          "submissions"
        ],
        "title": "BulkSyncPayload",
        "description": "A bulk list of ePRO submissions for offline queue reconciliation."
      },
      "ConflictStrategy": {
        "type": "string",
        "enum": [
          "CLIENT_WINS",
          "SERVER_WINS",
          "MERGE"
        ],
        "title": "ConflictStrategy",
        "description": "Explicit validated conflict resolution strategies."
      },
      "CriterionExplanation": {
        "properties": {
          "criterion_id": {
            "type": "string",
            "title": "Criterion Id",
            "description": "The ID of the criterion evaluated."
          },
          "criterion_type": {
            "type": "string",
            "title": "Criterion Type",
            "description": "inclusion or exclusion."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable text of the criterion."
          },
          "is_met": {
            "type": "boolean",
            "title": "Is Met",
            "description": "Indicates if the subject satisfies this criterion."
          },
          "is_indeterminate": {
            "type": "boolean",
            "title": "Is Indeterminate",
            "description": "Indicates if evaluation was indeterminate."
          }
        },
        "type": "object",
        "required": [
          "criterion_id",
          "criterion_type",
          "description",
          "is_met",
          "is_indeterminate"
        ],
        "title": "CriterionExplanation"
      },
      "EPROSubmissionPayload": {
        "properties": {
          "subject_id": {
            "type": "string",
            "title": "Subject Id",
            "description": "Pseudonymized identifier of the subject"
          },
          "diary_id": {
            "type": "string",
            "title": "Diary Id",
            "description": "Unique identifier for the diary or survey"
          },
          "device_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Device Timestamp",
            "description": "ISO 8601 timestamp when the entry was created on device"
          },
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers",
            "description": "The questionnaire response key-values"
          },
          "offline_sync_markers": {
            "$ref": "#/components/schemas/OfflineSyncMarkers",
            "description": "The offline sync queue conflict tracking parameters"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "diary_id",
          "device_timestamp",
          "answers",
          "offline_sync_markers"
        ],
        "title": "EPROSubmissionPayload",
        "description": "A single participant ePRO/eCOA diary submission."
      },
      "FHIRPreScreenRequest": {
        "properties": {
          "study_id": {
            "type": "string",
            "title": "Study Id",
            "description": "Unique identifier of the clinical study"
          },
          "bundle": {
            "additionalProperties": true,
            "type": "object",
            "title": "Bundle",
            "description": "The standard FHIR Bundle JSON payload"
          }
        },
        "type": "object",
        "required": [
          "study_id",
          "bundle"
        ],
        "title": "FHIRPreScreenRequest",
        "description": "Payload for advisory FHIR eligibility pre-screening."
      },
      "FHIRPreScreenResponse": {
        "properties": {
          "eligible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eligible",
            "description": "Aggregated eligibility. True if all criteria met, False if any failed, None if indeterminate."
          },
          "failed_criteria": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Failed Criteria",
            "description": "List of criterion IDs that failed."
          },
          "indeterminate_criteria": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Indeterminate Criteria",
            "description": "List of criterion IDs that were indeterminate."
          },
          "criteria_explanations": {
            "items": {
              "$ref": "#/components/schemas/CriterionExplanation"
            },
            "type": "array",
            "title": "Criteria Explanations",
            "description": "Detailed list of criterion-level explanations."
          }
        },
        "type": "object",
        "title": "FHIRPreScreenResponse"
      },
      "FHIRPrefillRequest": {
        "properties": {
          "study_id": {
            "type": "string",
            "title": "Study Id",
            "description": "Unique identifier of the clinical study"
          },
          "bundle": {
            "additionalProperties": true,
            "type": "object",
            "title": "Bundle",
            "description": "The standard FHIR Bundle JSON payload"
          }
        },
        "type": "object",
        "required": [
          "study_id",
          "bundle"
        ],
        "title": "FHIRPrefillRequest",
        "description": "Payload for pre-filling CDASH fields using a FHIR bundle."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
