{
  "openapi": "3.1.0",
  "info": {
    "title": "Cadence Clinical - FHIR / eSource & eCOA Sync Gateway",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Service health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/fhir/prefill": {
      "post": {
        "summary": "Fhir Prefill",
        "description": "Ingest a standard FHIR Bundle payload, pseudonymize Patient ID,\nstrip all Direct Identifiers (PII), and return mapped CDASH eCRF fields.",
        "operationId": "fhir_prefill_api_v1_interop_fhir_prefill_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FHIRPrefillRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Fhir Prefill Api V1 Interop Fhir Prefill Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/fhir/pre-screen": {
      "post": {
        "summary": "Fhir Pre Screen",
        "description": "Advisory FHIR eligibility pre-screening endpoint. Orchestrates projection,\nMDR criteria retrieval, kleene AST evaluation, and non-PHI audit logging.\nStrictly isolated from clinical subject execution data mutations.",
        "operationId": "fhir_pre_screen_api_v1_interop_fhir_pre_screen_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FHIRPreScreenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FHIRPreScreenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/epro/submit": {
      "post": {
        "summary": "Epro Submit",
        "description": "Secure REST endpoint for mobile apps to submit a single participant diary/survey entry.\nHandles offline queue reconciliation & conflict resolution on duplicate sync requests.",
        "operationId": "epro_submit_api_v1_interop_epro_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EPROSubmissionPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Epro Submit Api V1 Interop Epro Submit Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/epro/sync": {
      "post": {
        "summary": "Epro Sync",
        "description": "Secure bulk sync endpoint for offline queues. Performs reconciliation\nand conflict resolution across multiple participant submissions.",
        "operationId": "epro_sync_api_v1_interop_epro_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkSyncPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Epro Sync Api V1 Interop Epro Sync Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/instruments": {
      "post": {
        "summary": "Create Instrument",
        "description": "Author a new eCOA questionnaire/diary definition.\nEnforces staff role authentication and Part 11 auditing.",
        "operationId": "create_instrument_api_v1_interop_instruments_post",
