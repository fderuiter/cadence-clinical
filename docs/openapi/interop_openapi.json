              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/assignments": {
      "post": {
        "summary": "Create Subject Assignment",
        "description": "Assign an eCOA instrument to a subject with due/recurrence window data.\nEnforces staff role authorization, validates instrument reference, and logs audit fields.",
