    "/api/v1/interop/reminders/compute": {
      "post": {
        "summary": "Compute Reminders",
        "description": "Compute due reminders from assignment schedules on demand.\nGenerates notifications for uncompleted assignments whose due window is reached.",
        "operationId": "compute_reminders_api_v1_interop_reminders_compute_post",
        "parameters": [
          {
            "name": "subject_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subject Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Compute Reminders Api V1 Interop Reminders Compute Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
