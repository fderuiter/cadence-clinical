            "title": "Description",
            "description": "Optional description"
          },
          "items": {
            "additionalProperties": true,
            "type": "object",
            "title": "Items",
            "description": "Items/questions"
          },
          "response_types": {
            "additionalProperties": true,
            "type": "object",
            "title": "Response Types",
            "description": "Response types and options"
          },
          "scoring_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Scoring Metadata",
            "description": "Scoring metadata"
          },
          "reason_for_change": {
            "type": "string",
            "title": "Reason For Change",
            "description": "21 CFR Part 11 compliant reason for change"
          }
        },
        "type": "object",
        "required": [
          "name",
          "items",
          "response_types",
          "scoring_metadata",
          "reason_for_change"
        ],
        "title": "InstrumentCreate"
      },
      "InstrumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "items": {
            "additionalProperties": true,
            "type": "object",
            "title": "Items"
          },
          "response_types": {
            "additionalProperties": true,
            "type": "object",
            "title": "Response Types"
          },
          "scoring_metadata": {
            "additionalProperties": true,
