    "/api/v1/interop/assignments/subject/{subject_id}": {
      "get": {
        "summary": "Get Subject Assignments",
        "description": "Retrieve all assignments for a given subject.\nEnforces subject-scoped identity boundary (Subject can only view their own assignments).",
        "operationId": "get_subject_assignments_api_v1_interop_assignments_subject__subject_id__get",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
