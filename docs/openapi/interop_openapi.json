{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Interop | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Interop"
        ],
        "summary": "Interoperability FHIR \u0026 CDISC connector health probe.",
        "operationId": "InteropHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Interop_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Interop"
        ],
        "summary": "Returns Interoperability operational status.",
        "operationId": "InteropStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Interop_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/interop/dct/dtp/shipments": {
      "get": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "List Direct-to-Patient drug shipments",
        "operationId": "ListDtpShipments",
        "parameters": [
          {
            "name": "study_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "site_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subject_pseudonym_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "Create Direct-to-Patient (DTP) courier dispatch order",
        "operationId": "CreateDtpShipment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Interop_DtpShipmentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/interop/dct/dtp/shipments/{trackingNumber}": {
      "get": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "Retrieve single DTP shipment details by tracking number",
        "operationId": "GetDtpShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/interop/dct/dtp/shipments/{trackingNumber}/temperature": {
      "post": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "Ingest cold-chain temperature telemetry points \u0026 calculate MKT",
        "operationId": "IngestDtpTemperature",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Interop_TemperatureIngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/interop/dct/dtp/shipments/{trackingNumber}/handoff": {
      "post": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "Record Chain of Custody (CoC) handoff event",
        "operationId": "RecordDtpHandoff",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Interop_CustodyHandoffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/interop/dct/dtp/shipments/{trackingNumber}/delivery": {
      "post": {
        "tags": [
          "DTP Logistics \u0026 Cold-Chain Telemetry"
        ],
        "summary": "Confirm final delivery with recipient signature",
        "operationId": "ConfirmDtpDelivery",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Interop_DeliveryConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Interop_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Interop_CustodyHandoffRequest": {
        "required": [
          "fromParty",
          "toPhase",
          "handedOverBy",
          "verificationSeal"
        ],
        "type": "object",
        "properties": {
          "fromParty": {
            "type": "string"
          },
          "toPhase": {
            "type": "string"
          },
          "handedOverBy": {
            "type": "string"
          },
          "verificationSeal": {
            "type": "string"
          }
        }
      },
      "Interop_DeliveryConfirmRequest": {
        "required": [
          "recipientName",
          "signatureToken",
          "deliveryNotes"
        ],
        "type": "object",
        "properties": {
          "recipientName": {
            "type": "string"
          },
          "signatureToken": {
            "type": "string"
          },
          "deliveryNotes": {
            "type": "string"
          }
        }
      },
      "Interop_DtpShipmentCreateRequest": {
        "required": [
          "studyId",
          "siteId",
          "subjectPseudonymId",
          "destinationAddressPseudonym",
          "tamperSealId",
          "kitSerials"
        ],
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "subjectPseudonymId": {
            "type": "string"
          },
          "destinationAddressPseudonym": {
            "type": "string"
          },
          "tamperSealId": {
            "type": "string"
          },
          "kitSerials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "courierName": {
            "type": "string",
            "default": "World Courier"
          },
          "temperatureZone": {
            "type": "string",
            "default": "REFRIGERATED"
          }
        }
      },
      "Interop_TemperatureIngestRequest": {
        "required": [
          "readings"
        ],
        "type": "object",
        "properties": {
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Interop_TemperatureReadingDto"
            }
          }
        }
      },
      "Interop_TemperatureReadingDto": {
        "required": [
          "timestampUtc",
          "temperatureCelsius"
        ],
        "type": "object",
        "properties": {
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "temperatureCelsius": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "loggerId": {
            "type": "string",
            "default": "LOGGER-01"
          },
          "batteryPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 100
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Interop"
    },
    {
      "name": "DTP Logistics \u0026 Cold-Chain Telemetry"
    }
  ]
}
