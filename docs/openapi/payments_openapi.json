  "components": {
    "schemas": {
      "Payments_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Payments_BulkFeeScheduleCommitRequest": {
        "required": [
          "rows",
          "createdBy"
        ],
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payments_FeeScheduleImportRowInput"
            }
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Payments_BulkFeeScheduleCommitResult": {
        "required": [
          "success",
          "importedContractsCount",
          "importedFeeSchedulesCount",
          "totalCommittedBudget",
          "message",
          "contractIds"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "importedContractsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "importedFeeSchedulesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCommittedBudget": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "message": {
            "type": "string"
          },
          "contractIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Payments_BulkFeeScheduleValidationResult": {
        "required": [
          "totalRows",
          "validRowsCount",
          "invalidRowsCount",
          "isValid",
          "totalEstimatedBudget",
          "rows",
          "globalErrors"
        ],
        "type": "object",
        "properties": {
          "totalRows": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "validRowsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "invalidRowsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isValid": {
            "type": "boolean"
          },
          "totalEstimatedBudget": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payments_FeeScheduleImportRow"
            }
          },
          "globalErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Payments_DisburseFundsRequestDto": {
        "required": [
          "disbursementType",
          "amount"
        ],
        "type": "object",
        "properties": {
          "disbursementType": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "Payments_DisburseStipendRequest": {
        "required": [
          "subjectId",
          "studyId",
          "siteId",
          "sequenceNumber",
          "assignmentId",
          "diaryId",
          "amount",
          "idempotencyKey",
          "disbursementType"
        ],
        "type": "object",
        "properties": {
          "subjectId": {
            "type": "string"
          },
          "studyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "siteId": {
            "type": [
              "null",
              "string"
            ]
          },
          "sequenceNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "assignmentId": {
            "type": [
              "null",
              "string"
            ]
          },
          "diaryId": {
            "type": [
              "null",
              "string"
            ]
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "idempotencyKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "disbursementType": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Payments_FeeScheduleImportRow": {
        "required": [
          "rowNumber",
          "studyId",
          "siteId",
          "visitCode",
          "procedureCode",
          "procedureName",
          "baseAmount",
          "overheadPercentage",
          "withholdingPercentage",
          "patientStipend",
          "travelReimbursement",
          "requiresSdv",
          "overheadAmount",
          "grossAmount",
          "withholdingAmount",
          "netPayable",
          "validationErrors"
        ],
        "type": "object",
        "properties": {
          "rowNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "studyId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "visitCode": {
            "type": "string"
          },
          "procedureCode": {
            "type": "string"
          },
          "procedureName": {
            "type": "string"
          },
          "baseAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "overheadPercentage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
