          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "default": 3600
          },
