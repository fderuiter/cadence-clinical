{
  "openapi": "3.1.0",
  "info": {
    "title": "Cadence Clinical - Fileshare & Media Service",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/fileshare/files/upload-url": {
      "post": {
        "tags": [
          "Fileshare"
        ],
        "summary": "Get Upload Url",
        "description": "Allocate draft file record and generate presigned PUT or multipart upload URLs.\n\nRequirements: PRD-SYS-001, PRD-DOC-001, PRD-DOC-002",
        "operationId": "get_upload_url_api_v1_fileshare_files_upload_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadUrlResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fileshare/files/{file_id}/download-url": {
      "get": {
        "tags": [
          "Fileshare"
        ],
        "summary": "Get Download Url",
        "description": "Retrieve short-lived presigned GET download URL with permission and watermark verification.\n\nRequirements: PRD-SYS-001, PRD-DOC-001, PRD-DOC-003",
        "operationId": "get_download_url_api_v1_fileshare_files__file_id__download_url_get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDownloadUrlResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fileshare/files/{file_id}": {
      "get": {
        "tags": [
          "Fileshare"
        ],
        "summary": "Get File Record",
        "description": "Retrieve file record metadata.\n\nRequirements: PRD-SYS-001, PRD-DOC-001",
        "operationId": "get_file_record_api_v1_fileshare_files__file_id__get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileRecordResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fileshare/files": {
      "get": {
        "tags": [
          "Fileshare"
        ],
        "summary": "List Files",
        "description": "List active file records for a study and site.\n\nRequirements: PRD-SYS-001, PRD-DOC-001",
        "operationId": "list_files_api_v1_fileshare_files_get",
        "parameters": [
          {
            "name": "study_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Study Id"
            }
          },
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileRecordResponse"
                  },
                  "title": "Response List Files Api V1 Fileshare Files Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fileshare/files/{file_id}/grants": {
      "post": {
        "tags": [
          "Fileshare"
        ],
        "summary": "Create Share Grant",
        "description": "Delegate file permissions via an internal share grant.\n\nRequirements: PRD-SYS-001, PRD-DOC-001, PRD-DOC-003",
        "operationId": "create_share_grant_api_v1_fileshare_files__file_id__grants_post",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareGrantCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareGrantResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fileshare/files/{file_id}/guest-links": {
      "post": {
        "tags": [
          "Fileshare"
        ],
        "summary": "Create Guest Link",
        "description": "Generate a time-bounded external guest link.\n\nRequirements: PRD-SYS-001, PRD-DOC-001",
        "operationId": "create_guest_link_api_v1_fileshare_files__file_id__guest_links_post",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestLinkCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestLinkResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Service health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
