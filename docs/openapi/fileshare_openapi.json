      "FileUploadUrlRequest": {
        "properties": {
          "study_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Study Id"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Id"
          },
          "filename": {
            "type": "string",
