            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Mime Type"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size Bytes"
          },
          "reason_for_change": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Reason For Change"
          },
          "is_multipart": {
            "type": "boolean",
            "title": "Is Multipart",
            "default": false
          },
          "parts_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Parts Count",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "study_id",
          "filename",
          "mime_type",
          "size_bytes",
          "reason_for_change"
        ],
        "title": "FileUploadUrlRequest",
        "description": "Request payload to initiate a single-part or multipart upload session."
      },
      "FileUploadUrlResponse": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
