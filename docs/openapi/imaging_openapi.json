  "paths": {
    "/api/v1/imaging/upload": {
      "post": {
        "tags": [
          "Medical Imaging"
        ],
        "summary": "Upload Dicom",
        "description": "Uploads and de-identifies DICOM file(s) or ZIP archives in-flight before persisting to S3.\n\n@req:PRD-IMG-001\n@req:PRD-IMG-002",
        "operationId": "upload_dicom_api_v1_imaging_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_dicom_api_v1_imaging_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DicomUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/imaging/deidentify": {
      "post": {
        "tags": [
          "Medical Imaging"
        ],
        "summary": "Deidentify In Flight",
        "description": "Performs in-memory de-identification on an uploaded DICOM file without persistent storage.\n\nReturns the clean, de-identified DICOM bytes with certificate metadata headers.\n\n@req:PRD-IMG-002",
        "operationId": "deidentify_in_flight_api_v1_imaging_deidentify_post",
