    "/api/v1/imaging/adjudications/{sessionId}/chair-adjudicate": {
      "post": {
        "tags": [
          "Imaging Adjudication"
        ],
        "summary": "Records the adjudication chair\u0027s binding consensus response and rationale for a discordant session.",
        "operationId": "ChairAdjudicateImagingSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sig-Token",
            "in": "header",
            "description": "Single-use 60-second step-up electronic signature JWT issued by POST /api/v1/auth/signature-verification and bound to this exact action and semantic meaning (21 CFR 11.200(a)(1)).",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Imaging_ChairAdjudicateImagingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
