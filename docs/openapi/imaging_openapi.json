    "/api/v1/imaging/studies/{studyUid}/series/{seriesUid}/segment": {
      "post": {
        "tags": [
          "Imaging Segmentation"
        ],
        "summary": "Requests automatic ROI lesion segmentation for a DICOM series (returns 501 Not Implemented until a segmentation model is wired).",
        "description": "HTTP 501 Not Implemented stub: no automatic segmentation model is wired, so this route validates study/site scope and returns RFC 7807 ProblemDetails (501) without storing synthetic measurements.",
        "operationId": "SegmentRoiSeed",
        "parameters": [
          {
            "name": "studyUid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seriesUid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Imaging_SegmentRoiRequest"
              }
