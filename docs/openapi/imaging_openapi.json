  "components": {
    "schemas": {
      "Imaging_AdjudicationSessionResponse": {
        "required": [
          "sessionId",
          "studyId",
          "subjectId",
          "timepointName",
          "workflowStatus",
          "isResponseDiscordant",
          "sldDiscordanceDelta",
          "discordanceReasons",
          "finalConsensusResponse",
          "finalConsensusSldMm",
          "bindingReader",
          "adjudicationRationale",
          "sessionDigest"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "timepointName": {
            "type": "string"
          },
          "workflowStatus": {
            "type": "string"
          },
          "isResponseDiscordant": {
            "type": "boolean"
          },
          "sldDiscordanceDelta": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "discordanceReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finalConsensusResponse": {
            "type": [
              "null",
              "string"
            ]
          },
          "finalConsensusSldMm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "bindingReader": {
            "type": [
              "null",
              "string"
            ]
          },
          "adjudicationRationale": {
            "type": [
              "null",
              "string"
            ]
          },
          "sessionDigest": {
            "type": "string"
          }
        }
      },
      "Imaging_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Imaging_BatchDeidentificationManifest": {
        "type": "object",
        "properties": {
          "manifest_id": {
            "type": "string"
          },
          "study_envelope_id": {
            "type": "string"
          },
          "study_id": {
            "type": "string"
          },
          "site_id": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "total_files_processed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ingested_slice_count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skipped_non_dicom_count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skipped_non_dicom_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scrubbed_tags_count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "scrubbed_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pixel_mask_applied": {
            "type": "boolean"
          },
          "pixel_masks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Imaging_PixelMaskBoundingBox"
            }
          },
          "operator_identity": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "signature": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Imaging_BatchIngestionResult": {
        "required": [
          "studyEnvelopeId",
          "certificateId",
          "anonymizedStudyUid",
          "totalFilesReceived",
          "ingestedSliceCount",
          "skippedNonDicomCount",
          "skippedNonDicomFiles",
          "seriesSummary",
          "manifest",
          "signature"
        ],
        "type": "object",
        "properties": {
          "studyEnvelopeId": {
            "type": "string"
          },
          "certificateId": {
            "type": "string"
          },
          "anonymizedStudyUid": {
            "type": "string"
          },
          "totalFilesReceived": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ingestedSliceCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skippedNonDicomCount": {
