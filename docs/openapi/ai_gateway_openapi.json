{
  "openapi": "3.1.0",
  "info": {
    "title": "Cadence Clinical - AI Gateway Service",
    "description": "Centralized AI routing, tier management, structured output extraction, and embeddings.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/ai/generate": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Execute AI text generation or structured extraction",
        "description": "Generate completion text or structured JSON data conforming to a requested schema.\n\nArgs:\n    payload: GenerationRequestDTO containing prompt/messages, tier, and optional schema.\n    engine: Injected AIEnginePort adapter.\n\nReturns:\n    GenerationResponseDTO with content, structured data, token usage, and telemetry.\n\nRaises:\n    HTTPException: If payload is missing prompt/messages or inference fails.",
        "operationId": "generate_completion_api_v1_ai_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponseDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/embed": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Generate dense vector embeddings for input texts",
        "description": "Generate float vector embeddings for input text strings.\n\nArgs:\n    payload: EmbeddingRequestDTO containing batch of text strings and model tier.\n    engine: Injected AIEnginePort adapter.\n\nReturns:\n    EmbeddingResponseDTO containing generated float vectors and usage metrics.\n\nRaises:\n    HTTPException: If embedding generation encounters an upstream error.",
        "operationId": "generate_embeddings_api_v1_ai_embed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponseDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/tiers": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Retrieve active configuration and model mapping across execution tiers",
        "description": "List all available execution tiers and active model configurations.\n\nArgs:\n    engine: Injected AIEnginePort adapter.\n\nReturns:\n    List of TierInfoDTO describing active tier mappings and capabilities.",
        "operationId": "list_tiers_api_v1_ai_tiers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TierInfoDTO"
                  },
                  "type": "array",
                  "title": "Response List Tiers Api V1 Ai Tiers Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/rag/protocol-triage": {
      "post": {
        "tags": [
          "Clinical RAG"
        ],
        "summary": "Execute grounded Tier 2 protocol RAG triage with citation markers",
        "description": "Executes grounded clinical RAG answering support inquiries with verbatim citations.\n\nEnforces:\n- Verbatim citation markers: `[Protocol v2.1, Section 7.3, Page 42]`\n- Mathematical faithfulness calculation (85% confidence gate)\n- Fail-closed behavior on missing or unapproved protocol context",
        "operationId": "triage_protocol_query_api_v1_ai_rag_protocol_triage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProtocolRAGRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolRAGResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/reasoning/multi-step": {
      "post": {
        "tags": [
          "Clinical Reasoning"
        ],
        "summary": "Execute multi-step clinical reasoning planning loop with grounded citations",
        "description": "Executes a multi-step clinical reasoning workflow for protocol synthesis and patient data.\n\nEnforces:\n- Multi-step planning loops breaking down trial queries into discrete steps\n- In-flight PHI masking using temporary surrogate tokens for intermediate steps\n- Evaluation of protocol citations and 85% confidence threshold gate (fail-closed)\n- Stateless persistence with caller-managed execution state context\n- Staging generated clinical records into draft state requiring human e-signature\n- Mandatory tenant and audit context validation",
        "operationId": "execute_multi_step_reasoning_api_v1_ai_reasoning_multi_step_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicalReasoningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalReasoningResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/reasoning/plan": {
      "post": {
        "tags": [
          "Clinical Reasoning"
        ],
        "summary": "Initialize or advance a caller-managed multi-step clinical reasoning plan",
        "description": "Initialize or advance a multi-step clinical reasoning loop statelessly.",
        "operationId": "plan_clinical_reasoning_api_v1_ai_reasoning_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicalReasoningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalReasoningResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health Check",
        "description": "Service health check endpoint.",
        "operationId": "health_check_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Service health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatMessageDTO": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageRole"
              },
              {
                "type": "string"
              }
            ],
            "title": "Role",
            "description": "Role of the message author.",
            "default": "user"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Text content of the message."
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ChatMessageDTO",
        "description": "Chat message transfer object."
      },
      "ClinicalReasoningRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "title": "Query",
            "description": "Complex clinical trial reasoning query."
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "description": "Mandatory tenant isolation identifier."
          },
          "study_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Study Id",
            "description": "Target study identifier."
          },
          "protocol_chunks": {
            "items": {
              "$ref": "#/components/schemas/ProtocolRAGContextChunk"
            },
            "type": "array",
            "title": "Protocol Chunks",
            "description": "Clinical trial protocol chunks for citation verification."
          },
          "patient_records": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Records",
            "description": "Patient records or clinical context containing sensitive identifiers."
          },
          "execution_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionStateContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "Caller-managed execution state context for stateless continuation."
          },
          "min_citation_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Citation Confidence",
            "description": "Minimum required citation confidence score (default 0.85).",
            "default": 0.85
          },
          "compliance_profile": {
            "type": "string",
            "title": "Compliance Profile",
            "description": "Compliance profile for PHI detection (HIPAA, GDPR, EU_CTR).",
            "default": "HIPAA"
          },
          "esignature_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Esignature Context",
            "description": "Electronic signature & audit context passed across execution steps."
          }
        },
        "type": "object",
        "required": [
          "query",
          "tenant_id"
        ],
        "title": "ClinicalReasoningRequest",
        "description": "Inbound request for multi-step clinical trial reasoning."
      },
      "ClinicalReasoningResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Execution status ('DRAFT_STAGED', 'REJECTED_LOW_CONFIDENCE', 'COMPLETED', 'ERROR')."
          },
          "draft_record": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftClinicalRecord"
              },
              {
                "type": "null"
              }
            ],
            "description": "Staged draft clinical record (None if rejected or low confidence)."
          },
          "reasoning_chain": {
            "items": {
              "$ref": "#/components/schemas/ReasoningStepState"
            },
            "type": "array",
            "title": "Reasoning Chain",
            "description": "Discrete multi-step planning loop execution history."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/ParsedCitation"
            },
            "type": "array",
            "title": "Citations",
            "description": "Extracted & verified protocol citations."
          },
          "overall_faithfulness_score": {
            "type": "number",
            "title": "Overall Faithfulness Score",
            "description": "Overall citation confidence score (0.0 to 1.0)."
          },
          "is_citation_verified": {
            "type": "boolean",
            "title": "Is Citation Verified",
            "description": "True if overall faithfulness >= min_citation_confidence."
          },
          "phi_masking_applied": {
            "type": "boolean",
            "title": "Phi Masking Applied",
            "description": "True if PHI masking was applied to intermediate steps."
          },
          "phi_tokens_masked": {
            "type": "integer",
            "title": "Phi Tokens Masked",
            "description": "Total surrogate PHI tokens masked during execution."
          },
          "execution_state": {
            "$ref": "#/components/schemas/ExecutionStateContext",
            "description": "Updated caller-managed execution state context."
          },
          "model_used": {
            "type": "string",
            "title": "Model Used",
            "description": "AI model used.",
            "default": "tier-3-frontier-reasoning"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "description": "Latency in milliseconds.",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "status",
          "overall_faithfulness_score",
          "is_citation_verified",
          "phi_masking_applied",
          "phi_tokens_masked",
          "execution_state"
        ],
        "title": "ClinicalReasoningResponse",
        "description": "Outbound response containing staged draft record, reasoning chain, and telemetry."
      },
      "DraftClinicalRecord": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id",
            "description": "Unique draft record identifier."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Draft clinical record title."
          },
          "study_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Study Id",
            "description": "Associated study ID."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Draft state status requiring explicit human review/signature before release.",
            "default": "DRAFT_STAGED"
          },
          "synthesized_guidelines": {
            "type": "string",
            "title": "Synthesized Guidelines",
            "description": "Synthesized clinical guidelines and protocol analysis."
          },
          "eligibility_criteria": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Eligibility Criteria",
            "description": "Extracted eligibility criteria."
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/ParsedCitation"
            },
            "type": "array",
            "title": "Citations",
            "description": "Grounded verbatim protocol citations."
          },
          "requires_esignature": {
            "type": "boolean",
            "title": "Requires Esignature",
            "description": "Mandates explicit human review and e-signature authorization.",
            "default": true
          },
          "created_by_agent": {
            "type": "string",
            "title": "Created By Agent",
            "description": "Agent version identifier.",
            "default": "HybridClinicalReasoningAgent/v1"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601 creation timestamp."
          }
        },
        "type": "object",
        "required": [
          "record_id",
          "title",
          "synthesized_guidelines",
          "created_at"
        ],
        "title": "DraftClinicalRecord",
        "description": "Generated clinical trial record staged in draft state requiring human review."
      },
      "EmbeddingRequestDTO": {
        "properties": {
          "input_texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Input Texts",
            "description": "Batch of text strings to embed."
          },
          "tier": {
            "$ref": "#/components/schemas/ModelTier",
            "description": "Embedding model tier (defaults to Tier 1 local).",
            "default": "tier_1_local"
          },
          "model_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Override",
            "description": "Optional model override."
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Tenant identifier."
          },
          "custom_terms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Terms",
            "description": "Optional custom literal terms or patient names to redact."
          },
          "enable_deid": {
            "type": "boolean",
            "title": "Enable Deid",
            "description": "Whether to apply in-flight de-identification air-gap.",
            "default": true
          },
          "compliance_profile": {
            "type": "string",
            "title": "Compliance Profile",
            "description": "Compliance profile for PHI detection (HIPAA, GDPR, EU_CTR).",
            "default": "HIPAA"
          }
        },
        "type": "object",
        "required": [
          "input_texts"
        ],
        "title": "EmbeddingRequestDTO",
        "description": "Inbound DTO for vector embedding generation."
      },
      "EmbeddingResponseDTO": {
        "properties": {
          "embeddings": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Embeddings",
            "description": "List of dense float vectors."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Active embedding model."
          },
          "tier": {
            "$ref": "#/components/schemas/ModelTier",
            "description": "Resolved model tier."
          },
          "usage": {
            "$ref": "#/components/schemas/TokenUsageDTO",
            "description": "Token usage metrics."
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "description": "Request latency in milliseconds.",
            "default": 0.0
          },
          "deid_applied": {
            "type": "boolean",
            "title": "Deid Applied",
            "description": "Whether in-flight de-identification was applied to input texts.",
            "default": false
          },
          "deid_tokens_count": {
            "type": "integer",
            "title": "Deid Tokens Count",
            "description": "Count of surrogate tokens replaced in input texts.",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "embeddings",
          "model",
          "tier"
        ],
        "title": "EmbeddingResponseDTO",
        "description": "Outbound DTO containing generated float vector embeddings."
      },
      "ExecutionStateContext": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Unique reasoning session correlation identifier."
          },
          "current_step_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Current Step Index",
            "description": "Index of the active reasoning step.",
            "default": 0
          },
          "total_steps": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Total Steps",
            "description": "Total planned steps in the reasoning workflow.",
            "default": 5
          },
          "completed_steps": {
            "items": {
              "$ref": "#/components/schemas/ReasoningStepState"
            },
            "type": "array",
            "title": "Completed Steps",
            "description": "List of previously completed reasoning steps."
          },
          "patient_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Context",
            "description": "Optional raw or masked patient record context."
          },
          "protocol_chunks": {
            "items": {
              "$ref": "#/components/schemas/ProtocolRAGContextChunk"
            },
            "type": "array",
            "title": "Protocol Chunks",
            "description": "Target clinical protocol context chunks."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary caller-supplied execution metadata."
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ExecutionStateContext",
        "description": "Caller-managed execution state context enabling stateless microservice persistence."
      },
      "GenerationRequestDTO": {
        "properties": {
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "Single-turn prompt string."
          },
          "messages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessageDTO"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages",
            "description": "Multi-turn conversation history."
          },
          "tier": {
            "$ref": "#/components/schemas/ModelTier",
            "description": "Execution tier (tier_1_local, tier_2_fast, tier_3_frontier).",
            "default": "tier_2_fast"
          },
          "model_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Override",
            "description": "Explicit model name override."
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "description": "Sampling temperature.",
            "default": 0.0
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Maximum tokens to generate."
          },
          "response_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Schema",
            "description": "JSON Schema for Pydantic v2 structured outputs."
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Tenant identifier for isolation and auditing."
          },
          "study_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Study Id",
            "description": "Study protocol scope identifier."
          },
          "custom_terms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Terms",
            "description": "Optional custom literal terms or patient names to redact."
          },
          "enable_deid": {
            "type": "boolean",
            "title": "Enable Deid",
            "description": "Whether to apply in-flight de-identification air-gap.",
            "default": true
          },
          "compliance_profile": {
            "type": "string",
            "title": "Compliance Profile",
            "description": "Compliance profile for PHI detection (HIPAA, GDPR, EU_CTR).",
            "default": "HIPAA"
          }
        },
        "type": "object",
        "title": "GenerationRequestDTO",
        "description": "Inbound DTO for AI text generation and structured completions."
      },
      "GenerationResponseDTO": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Generated text or serialized JSON."
          },
          "structured_data": {
