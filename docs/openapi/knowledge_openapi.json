  "components": {
    "schemas": {
      "ArticleApproveRequest": {
        "properties": {
          "reason_for_change": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason For Change"
          }
        },
        "type": "object",
        "required": [
          "reason_for_change"
        ],
        "title": "ArticleApproveRequest",
        "description": "Request body for approving an article."
      },
      "ArticleCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "slug": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Slug"
          },
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "body_markdown": {
            "type": "string",
            "minLength": 1,
            "title": "Body Markdown"
          },
          "version_label": {
            "type": "string",
            "maxLength": 50,
            "title": "Version Label",
            "default": "1.0"
          },
          "tags": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          },
          "reason_for_change": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason For Change"
          }
        },
        "type": "object",
        "required": [
          "title",
          "slug",
          "category_id",
          "body_markdown",
          "reason_for_change"
        ],
        "title": "ArticleCreate",
        "description": "Request body for creating a new KnowledgeArticle (starts in DRAFT)."
      },
      "ArticleDraftSave": {
        "properties": {
          "body_markdown": {
            "type": "string",
            "minLength": 1,
            "title": "Body Markdown"
          },
          "reason_for_change": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
