      "post": {
        "tags": [
          "knowledge"
        ],
        "summary": "Approve Article",
        "description": "Approves an article in IN_REVIEW status (IN_REVIEW -> APPROVED).\n\nEnforces Four-Eyes check: approver cannot be author_user_id or last_edited_by.\nLocks current KnowledgeArticleVersion record as permanently immutable.",
        "operationId": "approve_article_api_v1_knowledge_articles__article_id__approve_post",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
