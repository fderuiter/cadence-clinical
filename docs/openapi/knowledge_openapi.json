  "components": {
    "schemas": {
      "Knowledge_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Knowledge_BatchAssignCurriculumRequest": {
        "required": [
          "curriculum_id",
          "study_id",
          "site_ids",
          "roles",
          "target_personnel_ids",
          "reason_for_change"
        ],
        "type": "object",
        "properties": {
          "curriculum_id": {
            "type": "string"
          },
          "study_id": {
            "type": "string"
          },
          "site_ids": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "target_personnel_ids": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "reason_for_change": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Knowledge_BatchAssignmentResponse": {
        "required": [
          "batch_transaction_id",
          "curriculum_id",
          "study_id",
          "total_eligible",
          "total_assigned",
          "total_skipped",
          "assignments",
          "skipped_items",
          "executed_at"
        ],
        "type": "object",
        "properties": {
          "batch_transaction_id": {
            "type": "string"
          },
          "curriculum_id": {
            "type": "string"
          },
          "study_id": {
            "type": "string"
          },
          "total_eligible": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total_assigned": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total_skipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Knowledge_TrainingAssignmentDto"
            }
          },
          "skipped_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Knowledge_SkippedAssignmentItemDto"
            }
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Knowledge_BulkDelegationSignOffRequest": {
        "required": [
          "delegation_ids",
          "study_id",
          "site_id",
          "signature_payload"
        ],
        "type": "object",
        "properties": {
          "delegation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "study_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "site_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "signature_payload": {
            "$ref": "#/components/schemas/Knowledge_SignaturePayloadDto"
          }
        }
      },
      "Knowledge_BulkDelegationSignOffResponse": {
        "required": [
          "batch_transaction_id",
          "total_requested",
          "total_signed",
          "total_failed",
          "signed_delegations",
          "failed_items",
          "sha256_seal",
          "etmf_artifact_id",
          "executed_at"
        ],
        "type": "object",
        "properties": {
          "batch_transaction_id": {
            "type": "string"
          },
          "total_requested": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total_signed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total_failed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
