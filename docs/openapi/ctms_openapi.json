{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Ctms | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Ctms"
        ],
        "summary": "CTMS operations health probe.",
        "operationId": "CtmsHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Ctms"
        ],
        "summary": "Returns CTMS operational status.",
        "operationId": "CtmsStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/render": {
      "post": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Renders a CTMS site visit monitoring letter via Liquid template.",
        "operationId": "RenderSiteVisitLetter",
        "parameters": [
          {
            "name": "templateName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_SiteVisitLetterModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/compile": {
      "post": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Compiles a GxP-compliant PDF visit letter with Part 11 electronic signature, eTMF filing, and automated email dispatch.",
        "operationId": "CompileSiteVisitLetterPdf",
        "parameters": [
          {
            "name": "templateName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_SiteVisitLetterModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_VisitLetterCompilationResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/{letterId}/pdf": {
      "get": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Downloads or views the compiled GxP PDF visit letter.",
        "operationId": "GetSiteVisitLetterPdf",
        "parameters": [
          {
            "name": "letterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ctms_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_SiteVisitFindingModel": {
        "required": [
          "text",
          "severity",
          "resolutionStatus"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "resolutionStatus": {
            "type": "string"
          }
        }
      },
      "Ctms_SiteVisitLetterModel": {
        "required": [
          "craId",
          "createdAt",
          "studyId",
          "siteId"
        ],
        "type": "object",
        "properties": {
          "craId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "visitType": {
            "type": "string",
            "default": "Monitoring"
          },
          "scheduledDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "actualDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "findings": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Ctms_SiteVisitFindingModel"
            }
          },
          "visitId": {
            "type": [
              "null",
              "string"
            ]
          },
          "finalize": {
            "type": "boolean",
            "default": false
          },
          "signerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "signingPurpose": {
            "type": [
              "null",
              "string"
            ]
          },
          "investigatorEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_VisitLetterCompilationResultDto": {
        "required": [
          "letterId",
          "visitId",
          "letterType",
          "pdfSha256Hash",
          "pdfObjectKey",
          "isSigned",
          "status",
          "signatureManifestation",
          "etmfDocumentId",
          "dispatchedAt",
          "pdfAccessUrl",
          "pdfBase64"
        ],
        "type": "object",
        "properties": {
          "letterId": {
            "type": "string"
          },
          "visitId": {
            "type": "string"
          },
          "letterType": {
            "type": "string"
          },
          "pdfSha256Hash": {
            "type": "string"
          },
          "pdfObjectKey": {
            "type": "string"
          },
          "isSigned": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "signatureManifestation": {
            "type": "string"
          },
          "etmfDocumentId": {
            "type": [
              "null",
              "string"
            ]
          },
          "dispatchedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "pdfAccessUrl": {
            "type": "string"
          },
          "pdfBase64": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Ctms"
    },
    {
      "name": "LetterTemplateEndpoints"
    }
  ]
}
