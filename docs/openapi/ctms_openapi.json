{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Ctms | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Ctms"
        ],
        "summary": "CTMS operations health probe.",
        "operationId": "CtmsHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Ctms"
        ],
        "summary": "Returns CTMS operational status.",
        "operationId": "CtmsStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/render": {
      "post": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Renders a CTMS site visit monitoring letter via Liquid template.",
        "operationId": "RenderSiteVisitLetter",
        "parameters": [
          {
            "name": "templateName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_SiteVisitLetterModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/compile": {
      "post": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Compiles a GxP-compliant PDF visit letter with Part 11 electronic signature, eTMF filing, and automated email dispatch.",
        "operationId": "CompileSiteVisitLetterPdf",
        "parameters": [
          {
            "name": "templateName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_SiteVisitLetterModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_VisitLetterCompilationResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/letters/{letterId}/pdf": {
      "get": {
        "tags": [
          "LetterTemplateEndpoints"
        ],
        "summary": "Downloads or views the compiled GxP PDF visit letter.",
        "operationId": "GetSiteVisitLetterPdf",
        "parameters": [
          {
            "name": "letterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/startup/sites/{siteId}/greenlight": {
      "get": {
        "tags": [
          "StartupGreenlightEndpoints"
        ],
        "summary": "Evaluates 6-facet greenlight readiness for a single trial site.",
        "operationId": "EvaluateSiteGreenlight",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_SiteGreenlightGateResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/startup/sites/{siteId}/greenlight/certify": {
      "post": {
        "tags": [
          "StartupGreenlightEndpoints"
        ],
        "summary": "Certifies greenlight activation for a single trial site, issuing an HMAC-SHA256 token.",
        "operationId": "CertifySiteGreenlight",
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Change-Reason",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_IClock"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_SiteGreenlightGateResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/startup/matrix": {
      "get": {
        "tags": [
          "StartupGreenlightEndpoints"
        ],
        "summary": "Displays country-level matrix showing 6-facet greenlight readiness for all sites in a selected country.",
        "operationId": "GetCountryGreenlightMatrix",
        "parameters": [
          {
            "name": "studyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ctms_SiteGreenlightGateResponseDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ctms/startup/matrix/batch-certify": {
      "post": {
        "tags": [
          "StartupGreenlightEndpoints"
        ],
        "summary": "Batch-certifies all selected 100% compliant sites in a target country with a single e-signature.",
        "operationId": "BatchCertifyCountrySites",
        "parameters": [
          {
            "name": "X-Change-Reason",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ctms_BatchCertifyRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_BatchCertifyResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Ctms_ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ctms_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_BatchCertifyRequestDto": {
        "required": [
          "studyId",
          "countryCode",
          "siteIds",
          "signerName",
          "signerRole",
          "meaning"
        ],
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "signerRole": {
            "type": [
              "null",
              "string"
            ]
          },
          "meaning": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_BatchCertifyResponseDto": {
        "required": [
          "success",
          "certifiedCount",
          "studyId",
          "countryCode",
          "certifiedSites",
          "message"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "certifiedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "studyId": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "certifiedSites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ctms_CertifiedSiteItemDto"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Ctms_CertifiedSiteItemDto": {
        "required": [
          "siteId",
          "siteName",
          "greenlightToken",
          "certifiedAt",
          "certifiedBy",
          "status"
        ],
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string"
          },
          "siteName": {
            "type": "string"
          },
          "greenlightToken": {
            "type": "string"
          },
          "certifiedAt": {
            "type": "string"
          },
          "certifiedBy": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Ctms_IClock": {
        "type": "object",
        "properties": {
          "utcNow": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Ctms_ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_SiteGreenlightGateResponseDto": {
        "required": [
          "id",
          "studyId",
          "siteId",
          "siteName",
          "countryCode",
          "overallStatus",
          "readinessPercentage",
          "facetRegulatoryIrb",
          "facetCtaBudget",
          "facetEisfBaseline",
          "facetDoaLog",
          "facetStaffTraining",
          "facetIpRelease",
          "isCompliant",
          "greenlightToken",
          "greenlightCertifiedBy",
          "greenlightCertifiedAt",
          "isOverridden",
          "unfulfilledReasons"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "siteName": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "overallStatus": {
            "type": "string"
          },
          "readinessPercentage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "facetRegulatoryIrb": {
            "type": "boolean"
          },
          "facetCtaBudget": {
            "type": "boolean"
          },
          "facetEisfBaseline": {
            "type": "boolean"
          },
          "facetDoaLog": {
            "type": "boolean"
          },
          "facetStaffTraining": {
            "type": "boolean"
          },
          "facetIpRelease": {
            "type": "boolean"
          },
          "isCompliant": {
            "type": "boolean"
          },
          "greenlightToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "greenlightCertifiedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "greenlightCertifiedAt": {
            "type": [
              "null",
              "string"
            ]
          },
          "isOverridden": {
            "type": "boolean"
          },
          "unfulfilledReasons": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Ctms_SiteVisitFindingModel": {
        "required": [
          "text",
          "severity",
          "resolutionStatus"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "resolutionStatus": {
            "type": "string"
          }
        }
      },
      "Ctms_SiteVisitLetterModel": {
        "required": [
          "craId",
          "createdAt",
          "studyId",
          "siteId"
        ],
        "type": "object",
        "properties": {
          "craId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "studyId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "visitType": {
            "type": "string",
            "default": "Monitoring"
          },
          "scheduledDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "actualDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "findings": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Ctms_SiteVisitFindingModel"
            }
          },
          "visitId": {
            "type": [
              "null",
              "string"
            ]
          },
          "finalize": {
            "type": "boolean",
            "default": false
          },
          "signerName": {
            "type": [
              "null",
              "string"
            ]
          },
          "signingPurpose": {
            "type": [
              "null",
              "string"
            ]
          },
          "investigatorEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonForChange": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Ctms_VisitLetterCompilationResultDto": {
        "required": [
          "letterId",
          "visitId",
          "letterType",
          "pdfSha256Hash",
          "pdfObjectKey",
          "isSigned",
          "status",
          "signatureManifestation",
          "etmfDocumentId",
          "dispatchedAt",
          "pdfAccessUrl",
          "pdfBase64"
        ],
        "type": "object",
        "properties": {
          "letterId": {
            "type": "string"
          },
          "visitId": {
            "type": "string"
          },
          "letterType": {
            "type": "string"
          },
          "pdfSha256Hash": {
            "type": "string"
          },
          "pdfObjectKey": {
            "type": "string"
          },
          "isSigned": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "signatureManifestation": {
            "type": "string"
          },
          "etmfDocumentId": {
            "type": [
              "null",
              "string"
            ]
          },
          "dispatchedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "pdfAccessUrl": {
            "type": "string"
          },
          "pdfBase64": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Ctms"
    },
    {
      "name": "LetterTemplateEndpoints"
    },
    {
      "name": "StartupGreenlightEndpoints"
    }
  ]
}
