{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Quality | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Quality"
        ],
        "summary": "Quality management health probe.",
        "operationId": "QualityHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quality/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Quality"
        ],
        "summary": "Returns Quality management operational status.",
        "operationId": "QualityStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quality/rbqm/site-risk-heatmaps": {
      "get": {
        "tags": [
          "SiteRiskHeatmap"
        ],
        "operationId": "GetSiteRiskHeatmap",
        "parameters": [
          {
            "name": "study_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_SiteRiskHeatmapMatrix"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quality/rbqm/site-risk-heatmaps/compute": {
      "post": {
        "tags": [
          "SiteRiskHeatmap"
        ],
        "operationId": "ComputeSiteRiskHeatmap",
        "parameters": [
          {
            "name": "study_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Change-Reason",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_SiteRiskHeatmapMatrix"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Quality_ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Quality_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Quality_ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Quality_SiteRiskCategoryScore": {
        "required": [
          "categoryKey",
          "categoryName",
          "riskScore",
          "riskTier",
          "triggeredMetricsCount",
          "details"
        ],
        "type": "object",
        "properties": {
          "categoryKey": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "riskScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "riskTier": {
            "type": "string"
          },
          "triggeredMetricsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "Quality_SiteRiskHeatmapMatrix": {
        "required": [
          "studyId",
          "evaluatedAtUtc",
          "totalSites",
          "highRiskSitesCount",
          "mediumRiskSitesCount",
          "lowRiskSitesCount",
          "categories",
          "rows"
        ],
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          },
          "evaluatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "totalSites": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "highRiskSitesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "mediumRiskSitesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lowRiskSitesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quality_SiteRiskHeatmapRow"
            }
          }
        }
      },
      "Quality_SiteRiskHeatmapRow": {
        "required": [
          "siteId",
          "siteName",
          "compositeRiskScore",
          "riskTier",
          "rank",
          "categoryScores",
          "activeQueriesCount",
          "activeDeviationsCount",
          "recommendedActions"
        ],
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string"
          },
          "siteName": {
            "type": "string"
          },
          "compositeRiskScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "riskTier": {
            "type": "string"
          },
          "rank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "categoryScores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quality_SiteRiskCategoryScore"
            }
          },
          "activeQueriesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "activeDeviationsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "recommendedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Quality"
    },
    {
      "name": "SiteRiskHeatmap"
    }
  ]
}
