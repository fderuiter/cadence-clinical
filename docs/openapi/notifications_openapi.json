{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Notifications | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Notifications"
        ],
        "summary": "Notifications dispatch health probe.",
        "operationId": "NotificationsHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Notifications"
        ],
        "summary": "Returns Notifications operational status.",
        "operationId": "NotificationsStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/render": {
      "post": {
        "tags": [
          "NotificationTemplateEndpoints"
        ],
        "summary": "Renders a Liquid notification template asynchronously.",
        "operationId": "RenderNotificationTemplate",
        "parameters": [
          {
            "name": "templateName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Notifications_NotificationRenderModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_RenderedNotification"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/vapid-public-key": {
      "get": {
        "tags": [
          "PushNotificationEndpoints"
        ],
        "summary": "Gets the VAPID public key for Web Push subscription negotiation.",
        "operationId": "GetVapidPublicKey",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_VapidPublicKeyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/subscriptions": {
      "post": {
        "tags": [
          "PushNotificationEndpoints"
        ],
        "summary": "Registers or updates a participant device Web Push subscription.",
        "operationId": "RegisterPushSubscription",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Notifications_PushSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_PushSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "PushNotificationEndpoints"
        ],
        "summary": "Deactivates or removes a device Web Push subscription.",
        "operationId": "UnsubscribePushSubscription",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/trigger-ecoa-job": {
      "post": {
        "tags": [
          "PushNotificationEndpoints"
        ],
        "summary": "Manually triggers the background eCOA visit window push scheduler job.",
        "operationId": "TriggerEcoaPushJob",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notifications_EcoaJobResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notifications_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Notifications_EcoaJobResponse": {
        "required": [
          "dispatchedCount"
        ],
        "type": "object",
        "properties": {
          "dispatchedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Notifications_NotificationPayload": {
        "type": "object",
        "properties": {
          "subjectId": {
            "type": "string",
            "default": ""
          },
          "adverseEventDescription": {
            "type": "string",
            "default": ""
          },
          "flagReason": {
            "type": "string",
            "default": ""
          },
          "discrepancySource": {
            "type": "string",
            "default": ""
          },
          "protocolVersion": {
            "type": "string",
            "default": ""
          },
          "versionNumber": {
            "type": "string",
            "default": ""
          },
          "changeSummary": {
            "type": "string",
            "default": ""
          },
          "summaryOfChanges": {
            "type": "string",
            "default": ""
          },
          "siteId": {
            "type": "string",
            "default": ""
          },
          "formName": {
            "type": "string",
            "default": ""
          },
          "fieldName": {
            "type": "string",
            "default": ""
          },
          "queryMessage": {
            "type": "string",
            "default": ""
          },
          "diaryName": {
            "type": "string",
            "default": ""
          },
          "dueDate": {
            "type": "string",
            "default": ""
          },
          "amendmentTag": {
            "type": "string",
            "default": ""
          },
          "versionIndex": {
            "type": "string",
            "default": ""
          },
          "changeReason": {
            "type": "string",
            "default": ""
          },
          "submittedBy": {
            "type": "string",
            "default": ""
          },
          "documentName": {
            "type": "string",
            "default": ""
          },
          "artifactCode": {
            "type": "string",
            "default": ""
          },
          "expirationDate": {
            "type": "string",
            "default": ""
          }
        }
      },
      "Notifications_NotificationRenderModel": {
        "required": [
          "studyId",
          "eventId",
          "timestampUtc",
          "payload"
        ],
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/Notifications_NotificationPayload"
          }
        }
      },
      "Notifications_ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Notifications_PushSubscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "p256dh": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "userAgent": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "versionIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reasonForChange": {
            "type": "string"
          }
        }
      },
      "Notifications_PushSubscriptionRequest": {
        "required": [
          "subjectId",
          "endpoint",
          "p256dh",
          "auth"
        ],
        "type": "object",
        "properties": {
          "subjectId": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "p256dh": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "userAgent": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Notifications_RenderedNotification": {
        "required": [
          "templateName",
          "content"
        ],
        "type": "object",
        "properties": {
          "templateName": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "Notifications_VapidPublicKeyResponse": {
        "required": [
          "publicKey"
        ],
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Notifications"
    },
    {
      "name": "NotificationTemplateEndpoints"
    },
    {
      "name": "PushNotificationEndpoints"
    }
  ]
}
