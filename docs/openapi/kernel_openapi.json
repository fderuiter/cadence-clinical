      "Kernel_KernelAmendmentImpactResponse": {
        "required": [
          "amended",
          "parent",
          "impacted_elements",
          "dependents"
        ],
        "type": "object",
        "properties": {
          "amended": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "impacted_elements": {
