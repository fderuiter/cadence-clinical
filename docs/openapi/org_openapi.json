{
  "openapi": "3.1.1",
  "info": {
    "title": "Cadence.Apps.Org | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Org"
        ],
        "summary": "Organization directory health probe.",
        "operationId": "OrgHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Org"
        ],
        "summary": "Returns Organization directory operational status.",
        "operationId": "OrgStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org/preferences/onboarding/{persona}": {
      "get": {
        "tags": [
          "OnboardingPreferencesEndpoints"
        ],
        "summary": "Fetch user onboarding preferences by persona route parameter",
        "operationId": "GetUserOnboardingPreferenceByRoute",
        "parameters": [
          {
            "name": "persona",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "OnboardingPreferencesEndpoints"
        ],
        "summary": "Save user onboarding preferences by persona route parameter",
        "operationId": "SaveUserOnboardingPreferenceByRoute",
        "parameters": [
          {
            "name": "persona",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Org_SaveUserOnboardingPreferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/org/preferences/onboarding": {
      "get": {
        "tags": [
          "OnboardingPreferencesEndpoints"
        ],
        "summary": "Fetch user onboarding preferences by persona query parameter",
        "operationId": "GetUserOnboardingPreference",
        "parameters": [
          {
            "name": "persona",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "OnboardingPreferencesEndpoints"
        ],
        "summary": "Save user onboarding preferences",
        "operationId": "SaveUserOnboardingPreference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Org_SaveUserOnboardingPreferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Org_AnonymousTypeOfstringAndstring": {
        "required": [
          "status",
          "service"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "service": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Org_SaveUserOnboardingPreferenceRequest": {
        "required": [
          "persona",
          "currentStep",
          "isActive",
          "disabled",
          "eventsJson",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "persona": {
            "type": [
              "null",
              "string"
            ]
          },
          "currentStep": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "eventsJson": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cadence.Apps.Org"
    },
    {
      "name": "OnboardingPreferencesEndpoints"
    }
  ]
}
