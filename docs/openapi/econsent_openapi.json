            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_PublishTemplateResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-cadence-auth": {
          "anonymous": false,
          "mode": "Permission"
        },
        "x-cadence-permissions": [
          "econsent_template:publish"
        ],
        "x-cadence-scopes": [
          "CallerStudyAndSite"
        ]
      }
