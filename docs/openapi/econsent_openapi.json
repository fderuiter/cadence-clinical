    "/api/v1/econsent/templates/{template_id}/versions/{version_index}/publish": {
      "post": {
        "tags": [
          "eConsent"
        ],
        "summary": "Publishes a specific eConsent template version and records whether participant re-consent is required.",
        "operationId": "PublishTemplateVersioned",
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version_index",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Econsent_PublishTemplateRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_PublishTemplateResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-cadence-auth": {
          "anonymous": false,
          "mode": "Permission"
        },
        "x-cadence-permissions": [
          "econsent_template:publish"
        ],
        "x-cadence-scopes": [
          "CallerStudyAndSite"
        ]
      }
    },
    "/api/v1/econsent/templates/{template_id}/publish": {
      "post": {
        "tags": [
          "eConsent"
        ],
        "summary": "Publishes the next version of an eConsent template for the specified protocol version.",
