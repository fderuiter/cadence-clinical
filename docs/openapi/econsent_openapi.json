    "/api/v1/econsent/templates/{template_id}/versions/{version_index}/capture-consent": {
      "post": {
        "tags": [
          "eConsent"
        ],
        "summary": "Captures a participant\u0027s 21 CFR Part 11 electronic consent signature against a versioned template.",
        "operationId": "CaptureConsentVersioned",
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version_index",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "X-Sig-Token",
            "in": "header",
            "description": "Single-use 60-second step-up electronic signature JWT issued by POST /api/v1/auth/signature-verification and bound to this exact action and semantic meaning (21 CFR 11.200(a)(1)).",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Econsent_CaptureConsentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_CaptureConsentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-cadence-auth": {
          "anonymous": false,
          "mode": "Permission"
        },
        "x-cadence-permissions": [
          "econsent_consent:capture"
        ],
        "x-cadence-scopes": [
          "CallerStudyAndSite"
        ]
      }
    },
    "/api/v1/econsent/templates/{template_id}/capture-consent": {
      "post": {
        "tags": [
          "eConsent"
        ],
        "summary": "Captures a participant\u0027s 21 CFR Part 11 electronic consent signature against the latest published template.",
        "operationId": "CaptureConsentLegacy",
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
