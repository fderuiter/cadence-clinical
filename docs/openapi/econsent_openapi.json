  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Cadence.Apps.Econsent"
        ],
        "summary": "eConsent service health probe.",
        "operationId": "EconsentHealthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/econsent/status": {
      "get": {
        "tags": [
          "Cadence.Apps.Econsent"
        ],
        "summary": "Returns eConsent operational status.",
