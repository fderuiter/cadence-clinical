          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/Econsent_ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-cadence-auth": {
          "anonymous": false,
          "mode": "Permission"
        },
        "x-cadence-permissions": [
          "econsent_consent:capture"
        ],
        "x-cadence-scopes": [
          "CallerStudyAndSite"
        ]
      }
    }
