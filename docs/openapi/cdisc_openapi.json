    "/api/v1/cdisc/codelists/{codelist_code}": {
      "get": {
        "tags": [
          "CDISC Standards"
        ],
        "summary": "Get Controlled Terminology Codelist",
        "description": "Retrieve controlled terminology codelist definition with local cache check.\n\nRequirements: PRD-SYS-001",
