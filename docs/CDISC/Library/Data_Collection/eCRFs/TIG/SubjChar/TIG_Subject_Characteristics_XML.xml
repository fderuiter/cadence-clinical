         <ItemDef OID="SC_TIG_ANY.SCPERF"
                  Name="SCPERF"
                  DataType="text"
                  Length="3">
            <Question>
               <TranslatedText>Were subject characteristics collected?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL_C66742_NY"/>
            <Alias Name="Indicate if subject characteristics information was collected. If Yes, record the appropriate details."
                   Context="completionInstructions"/>
            <Alias Name="SCPERF" Context="CDASH"/>
            <Alias Name="Subject Characteristics Collected" Context="prompt"/>
            <Alias Name="If SCPERF = &#34;Y&#34;, NOT SUBMITTED. If SCPERF = &#34;N&#34;, SCSTAT where SCTESTCD = &#34;SCALL&#34;."
                   Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.SHSMEXST_SCORRES"
                  Name="SHSMEXST_SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>Was the subject exposed to second hand smoke ?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_SECOND HAND SMOKE EXPOSURE STATUS"/>
