      <MetaDataVersion OID="ODM Exports" Name="ODM Exports" Description="">
         <FormDef OID="TIG_SUB_CHAR"
                  Name="Tobacco Implementation Guide-Subject Characteristics"
                  Repeating="No">
            <Description>
               <TranslatedText>This is an example CRF used to collect some basic subject characteristics data.</TranslatedText>
            </Description>
            <ItemGroupRef ItemGroupOID="TIG_SC_ANY" Mandatory="No" OrderNumber="1"/>
            <ItemGroupRef ItemGroupOID="TIG_SC_ITEM" Mandatory="Yes" OrderNumber="2"/>
         </FormDef>
         <ItemGroupDef OID="TIG_SC_ANY" Name="Any Subject Characteristics" Repeating="No">
            <ItemRef ItemOID="SC_TIG_ANY.SCPERF" Mandatory="Yes" OrderNumber="1"/>
         </ItemGroupDef>
         <ItemGroupDef OID="TIG_SC_ITEM" Name="Subject Chacteristics" Repeating="No">
            <ItemRef ItemOID="TIG_SC_ITEM.EDLEVEL_SCORRES"
                     Mandatory="No"
                     OrderNumber="1"/>
            <ItemRef ItemOID="SC_TIG_ITEM.JOBCLAS_SCORRES"
                     Mandatory="No"
                     OrderNumber="2"/>
            <ItemRef ItemOID="SC_TIG_ITEM.INCOME_SCORRES" Mandatory="No" OrderNumber="3"/>
            <ItemRef ItemOID="SC_TIG_ITEM.MARISTAT_SCORRES"
                     Mandatory="No"
                     OrderNumber="4"/>
            <ItemRef ItemOID="SC_TIG_ITEM.NATORIG_SCORRES"
                     Mandatory="No"
                     OrderNumber="5"/>
            <ItemRef ItemOID="SC_TIG_ITEM.MILTSTAT_SCORRES"
                     Mandatory="No"
                     OrderNumber="6"/>
            <ItemRef ItemOID="SC_TIG_ITEM.SHSMEXST_SCORRES"
                     Mandatory="No"
                     OrderNumber="7"/>
            <ItemRef ItemOID="TIG_SC_ITEM.AGESTSMK__SCORRES"
                     Mandatory="No"
                     OrderNumber="8"/>
            <ItemRef ItemOID="SC_TIG_ITEM.TBCESSCO__SCORRES"
                     Mandatory="No"
                     OrderNumber="9"/>
            <ItemRef ItemOID="SC_TIG_ITEM.LDURABS__SCORRES"
                     Mandatory="No"
                     OrderNumber="10"/>
         </ItemGroupDef>
         <ItemDef OID="TIG_SC_ITEM.AGESTSMK__SCORRES"
                  Name="AGESTSMK__SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What was the age of the subject when they started smoking?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_AGE STARTED SMOKING CAT"/>
            <Alias Name="Record the Age Category when the subject started smoking"
                   Context="completionInstructions"/>
            <Alias Name="AGESTSMK__SCORRES" Context="CDASH"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;AGESTSMK&#34;" Context="SDTM"/>
            <Alias Name="Age Started Smoking" Context="prompt"/>
         </ItemDef>
         <ItemDef OID="TIG_SC_ITEM.EDLEVEL_SCORRES"
                  Name="EDLEVEL_SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What is the subject's education level?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_EDUCATION LEVEL"/>
            <Alias Name="Indicate the subject's education level."
                   Context="completionInstructions"/>
            <Alias Name="EDLEVEL_SCORRES" Context="CDASH"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;EDLEVEL&#34;" Context="SDTM"/>
            <Alias Name="Education Level" Context="prompt"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.INCOME_SCORRES"
                  Name="INCOME_SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What is the subject's income?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_INCOME LEVEL"/>
            <Alias Name="Income" Context="prompt"/>
            <Alias Name="Indicate the subject's  income." Context="completionInstructions"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;INCOME&#34;" Context="SDTM"/>
            <Alias Name="INCOME_SCORRES" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.JOBCLAS_SCORRES"
                  Name="JOBCLAS_SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What is the subject’s employment status?</TranslatedText>
