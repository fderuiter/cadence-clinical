            <CodeListRef CodeListOID="TIG_SCTEST_Employment Status"/>
            <Alias Name="Employment Status" Context="prompt"/>
            <Alias Name="Indicate the subject's employment status."
                   Context="completionInstructions"/>
            <Alias Name="JOBCLAS_SCORRES" Context="CDASH"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;JOBCLAS&#34;" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.LDURABS__SCORRES"
                  Name="LDURABS__SCORRES"
                  DataType="text"
                  Length="40"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What is the longest duration of previous abstinence from tobacco use?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_LONGEST DURATION OF ABSTINENCE"/>
            <Alias Name="Record the longest duration of tobacco abstinence"
                   Context="completionInstructions"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;LDURABS&#34;" Context="SDTM"/>
            <Alias Name="LDURABS__SCORRES" Context="CDASH"/>
            <Alias Name="Longest Duration of  Abstinence" Context="prompt"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.MARISTAT_SCORRES"
                  Name="MARISTAT_SCORRES"
                  DataType="text"
                  Length="39"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>What is the subject's marital status?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_SC_MARRIAGE STATUS RESPONSE"/>
