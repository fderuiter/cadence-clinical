            <Alias Name="Indicate the subject's exposure to second hand smoke"
                   Context="completionInstructions"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;SHSMEXST&#34;" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="SC_TIG_ITEM.TBCESSCO__SCORRES"
                  Name="TBCESSCO__SCORRES"
                  DataType="text"
                  Length="3"
                  SDSVarName="SCORRES">
            <Question>
               <TranslatedText>Did the subject have any tobacco cessation counseling?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL_C66742_NY"/>
            <Alias Name="SCORRES WHERE SCTESTCD = &#34;TBCESSCO&#34;" Context="SDTM"/>
            <Alias Name="TBCESSCO__SCORRES" Context="CDASH"/>
            <Alias Name="Indicate whether the subject had previous tobacco cessation counseling."
                   Context="completionInstructions"/>
            <Alias Name="Tobacco Cessation Counseling" Context="prompt"/>
         </ItemDef>
