         <FormDef OID="TIG_VITAL_SIGNS"
                  Name="Tobacco Implementation Guide-Vital Signs"
                  Repeating="No">
            <Description>
               <TranslatedText>This is an example of a CRF used to collect vital signs.</TranslatedText>
            </Description>
            <ItemGroupRef ItemGroupOID="TIG_VITAL_SIGNS" Mandatory="No" OrderNumber="1"/>
         </FormDef>
         <ItemGroupDef OID="TIG_VITAL_SIGNS" Name="Vital Signs" Repeating="No">
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.VSDAT" Mandatory="No" OrderNumber="1"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.VSTIM" Mandatory="No" OrderNumber="2"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.HEIGHT" Mandatory="No" OrderNumber="3"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.HEIGHTU" Mandatory="No" OrderNumber="4"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.WEIGHT" Mandatory="No" OrderNumber="5"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.WEIGHTU" Mandatory="No" OrderNumber="6"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.TEMP" Mandatory="No" OrderNumber="7"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.TEMPU" Mandatory="No" OrderNumber="8"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.RESP" Mandatory="No" OrderNumber="9"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.RESPU" Mandatory="No" OrderNumber="10"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.SYSBP" Mandatory="No" OrderNumber="11"/>
            <ItemRef ItemOID="VS_TIG_VITL_SIGNS.SYSBP" Mandatory="No" OrderNumber="12"/>
