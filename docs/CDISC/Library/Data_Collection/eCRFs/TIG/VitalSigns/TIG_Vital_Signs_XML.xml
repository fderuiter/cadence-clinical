                  DataType="text"
                  Length="15"
                  SDSVarName="VSORRESU">
            <Question>
               <TranslatedText>What was the unit of the respiratory rate measurement?</TranslatedText>
            </Question>
            <Alias Name="VSORRESU where VSTESTCD = &#34;RESP&#34;" Context="SDTM"/>
            <Alias Name="breaths/min" Context="pre-filled"/>
            <Alias Name="Record or select the original unit in which these data were collected, if not pre-printed on CRF."
                   Context="completionInstructions"/>
            <Alias Name="Respiratory Unit" Context="prompt"/>
            <Alias Name="RESPUU" Context="CDASH"/>
         </ItemDef>
