            <Alias Name="VSORRES where VSTESTCD = &#34;TEMP&#34;" Context="SDTM"/>
            <Alias Name="TEMP" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="VS_TIG_VITAL_SIGNS.TEMPU"
                  Name="TEMPU"
                  DataType="text"
                  Length="15"
                  SDSVarName="VSORRESU">
            <Question>
               <TranslatedText>What was the unit of the temperature measurement?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL.C66770.VSRESU.TEMP"/>
            <Alias Name="Temperature Unit" Context="prompt"/>
