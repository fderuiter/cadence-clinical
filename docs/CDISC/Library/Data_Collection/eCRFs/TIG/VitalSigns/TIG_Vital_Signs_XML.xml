            <ItemRef ItemOID="VS_TIG_VITL_SIGNS.DIABP" Mandatory="No" OrderNumber="14"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.PULSE" Mandatory="No" OrderNumber="15"/>
            <ItemRef ItemOID="VS_TIG_VITAL_SIGNS.PULSEU" Mandatory="No" OrderNumber="16"/>
         </ItemGroupDef>
         <ItemDef OID="VS_TIG_VITAL_SIGNS.DIABP"
                  Name="DIABP"
                  DataType="integer"
                  Length="3"
                  SDSVarName="VSORRES">
            <Question>
               <TranslatedText>What was the diastolic blood pressure measurement?</TranslatedText>
            </Question>
            <Alias Name="VSORRES where VSTESTCD = &#34;DIABP&#34;" Context="SDTM"/>
            <Alias Name="Record the diastolic blood pressure result."
                   Context="completionInstructions"/>
            <Alias Name="DIABP" Context="CDASH"/>
            <Alias Name="Diastolic Blood Pressure" Context="Prompt"/>
         </ItemDef>
         <ItemDef OID="VS_TIG_VITL_SIGNS.DIABP"
                  Name="DIABPU"
                  DataType="text"
                  Length="15"
                  SDSVarName="VSORRESU">
            <Question>
               <TranslatedText>What was the unit of the diastolic blood pressure unit?</TranslatedText>
            </Question>
            <Alias Name="DIABPU" Context="CDASH"/>
            <Alias Name="Diastolic Blood Pressure  Unit" Context="prompt"/>
            <Alias Name="mmHg" Context="pre-filled"/>
            <Alias Name="Record or select the original unit in which these data were collected, if not pre-printed on CRF."
                   Context="completionInstructions"/>
            <Alias Name="VSORRESU where VSTESTCD = &#34;DIABP&#34;" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="VS_TIG_VITAL_SIGNS.HEIGHT"
                  Name="HEIGHT"
                  DataType="float"
                  Length="3"
                  SignificantDigits="1"
                  SDSVarName="VSORRES">
            <Question>
               <TranslatedText>What was the result of the height measurement?</TranslatedText>
            </Question>
            <Alias Name="HEIGHT" Context="CDASH"/>
            <Alias Name="VSORRES where VSTESTCD = &#34;HEIGHT&#34;SBP&#34;" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="VS_TIG_VITAL_SIGNS.HEIGHTU"
                  Name="HEIGHTU"
