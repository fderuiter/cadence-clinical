<?xml version="1.0" encoding="UTF-8"?>
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     FileOID="Tobacco Implementation Guide_1"
     FileType="Snapshot"
     CreationDateTime="2024-05-22T17:54:15"
