   <Study OID="STD_20">
      <GlobalVariables>
         <StudyName>Tobacco Implementation Guide</StudyName>
         <StudyDescription/>
         <ProtocolName/>
      </GlobalVariables>
      <BasicDefinitions/>
      <MetaDataVersion OID="ODM Exports" Name="ODM Exports" Description="">
         <FormDef OID="TIG_PROD_DEV_EVT_MAL"
                  Name="Tobacco Implementation Guide -Tobacco Device Product Events or Malfunctions"
                  Repeating="Yes">
            <Description>
               <TranslatedText>This form collects events and malfunctions associated with the operation of the tobacco product device.</TranslatedText>
            </Description>
            <ItemGroupRef ItemGroupOID="TIG_PROD_EVT_MAL_ANY" Mandatory="Yes" OrderNumber="1"/>
            <ItemGroupRef ItemGroupOID="TIG_PROD_EVT_MAL" Mandatory="No" OrderNumber="2"/>
         </FormDef>
         <ItemGroupDef OID="TIG_PROD_EVT_MAL_ANY"
                       Name="Any Product Device Events or Malfunctions"
                       Repeating="No">
            <ItemRef ItemOID="EM_TIG_PROD_EVT.EMYN" Mandatory="No" OrderNumber="1"/>
            <ItemRef ItemOID="EM_TIG_PROD_EVT.SPTOBID" Mandatory="No" OrderNumber="2"/>
         </ItemGroupDef>
         <ItemGroupDef OID="TIG_PROD_EVT_MAL"
                       Name="Product Device Events or Malfunctions"
                       Repeating="No">
            <ItemRef ItemOID="EM_TIG_PROD_EVT_MAL.EMTERM" Mandatory="No" OrderNumber="1"/>
            <ItemRef ItemOID="EM_TIG_PROD_EVT_MAL.EMSTDAT"
                     Mandatory="No"
                     OrderNumber="2"/>
            <ItemRef ItemOID="EM_TIG_PROD_EVT_MAL.EMPAT" Mandatory="No" OrderNumber="3"/>
            <ItemRef ItemOID="EM_TIG_PROD_EVT_MAL.EMACNDEV"
                     Mandatory="No"
                     OrderNumber="4"/>
            <ItemRef ItemOID="EM_TIG_PROD_EVT_MAL.EMAENO1"
                     Mandatory="No"
                     OrderNumber="5"/>
            <ItemRef ItemOID="EMI_TIG_PROD_EVT_MAL.EMAENO2"
                     Mandatory="No"
                     OrderNumber="6"/>
         </ItemGroupDef>
         <ItemDef OID="EM_TIG_PROD_EVT_MAL.EMACNDEV"
                  Name="EMACNDEV"
                  DataType="text"
                  Length="40"
                  SDSVarName="EMACNDEV">
            <Question>
               <TranslatedText>What action was taken with the device?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="EMACNDEV"/>
            <Alias Name="Record what action was taken with the device as a result of the event."
                   Context="completionInstructions"/>
            <Alias Name="Action Taken With Device" Context="prompt"/>
            <Alias Name="EMACNDEV" Context="CDASH"/>
            <Alias Name="EMACNDEV" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT_MAL.EMAENO1"
                  Name="EMAENO1"
                  DataType="text"
                  Length="10">
            <Question>
               <TranslatedText>What was the identifier for the primary adverse experiene(s) associated with or related to this device event?</TranslatedText>
            </Question>
            <Alias Name="Record the ID of the primary AE associated with event, if any."
                   Context="completionInstructions"/>
            <Alias Name="EMAENO1" Context="CDASH"/>
            <Alias Name="ASSOCIATE WITH RELATED RECORD VIA RELREC" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="EMI_TIG_PROD_EVT_MAL.EMAENO2"
                  Name="EMAENO2"
                  DataType="text"
                  Length="10">
            <Question>
               <TranslatedText>What was the identifier for the primary adverse experienc(s) associated with or related to this device event?</TranslatedText>
            </Question>
            <Alias Name="Record the ID of the primary AE associated with event, if any."
                   Context="completionInstructions"/>
            <Alias Name="EMAENO1" Context="CDASH"/>
            <Alias Name="ASSOCIATE WITH RELATED RECORD VIA RELREC" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT_MAL.EMPAT"
                  Name="EMPATT"
                  DataType="text"
                  Length="40"
                  SDSVarName="EMPATT">
            <Question>
               <TranslatedText>What was the pattern of the event?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_PIPATT"/>
            <Alias Name="Iindicate the pattern of the event over time."
                   Context="completionInstructions"/>
            <Alias Name="EMPATT" Context="SDTM"/>
            <Alias Name="EMPATT" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT_MAL.EMSTDAT"
                  Name="EMSTDAT"
                  DataType="date"
                  SDSVarName="EMSTDAT">
            <Question>
               <TranslatedText>Start Date</TranslatedText>
               <TranslatedText xml:lang="(default)">What was the start date when the event first occurred or was identified?</TranslatedText>
            </Question>
            <Alias Name="Record the date that the event first occurred or was noted using this format"
                   Context="completionInstructions"/>
            <Alias Name="EMSTDTC" Context="SDTM"/>
            <Alias Name="EMSTDAT" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT_MAL.EMTERM"
                  Name="EMTERM"
                  DataType="text"
                  Length="200"
                  SDSVarName="EMTERM">
            <Question>
               <TranslatedText>What was the event associated with this device?</TranslatedText>
            </Question>
            <Alias Name="EMTERM" Context="CDASH"/>
            <Alias Name="EMTERM" Context="SDTM"/>
            <Alias Name="Record a description of the toboacco product device event that occurred. Record only 1 event or malfunction per line."
                   Context="[completionInstructions]"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT.EMYN"
                  Name="EMYN"
                  DataType="text"
                  Length="3"
                  SDSVarName="Not submitted">
            <Question>
               <TranslatedText>Were any tobacco product events or malfunctions experienced?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL_C66742_NY"/>
            <Alias Name="Indicate if the subject experienced any tobacco product device events. If Yes, include the appropriate details where indicated on the CRF."
                   Context="completionInstructions"/>
            <Alias Name="Any Tobacco Product Device Events" Context="prompt"/>
            <Alias Name="EMYN" Context="CDASH"/>
            <Alias Name="NOT SUBMITTED" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="EM_TIG_PROD_EVT.SPTOBID"
                  Name="SPTOBID"
                  DataType="text"
                  Length="15"
                  SDSVarName="SPTOBID">
            <Question>
               <TranslatedText>What was the tobacco product identifier?</TranslatedText>
               <TranslatedText xml:lang="(en)">Tobacco Product Identifier</TranslatedText>
            </Question>
            <Alias Name="Tobacco Product Identifier" Context="prompt"/>
            <Alias Name="SPTOBID" Context="CDASH"/>
            <Alias Name="SPTOBID" Context="SDTM"/>
            <Alias Name="Indicate the tobacco product device that was associated with the event."
                   Context="completionInstructions"/>
         </ItemDef>
         <CodeList OID="EMACNDEV" Name="ACTION TAKEN WITH DEVICE" DataType="text">
            <CodeListItem CodedValue="DEVICE REPLACED" OrderNumber="1">
               <Decode>
                  <TranslatedText>Device Replaced</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="BATTERY REPLACED" OrderNumber="2">
               <Decode>
                  <TranslatedText>Battery Replaced</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="CALIBRATION" OrderNumber="3">
               <Decode>
                  <TranslatedText>Calibration</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="REPROGRAMMING" OrderNumber="4">
               <Decode>
                  <TranslatedText>Reprogramming</TranslatedText>
               </Decode>
            </CodeListItem>
         </CodeList>
         <CodeList OID="CL_C66742_NY" Name="No Yes Response" DataType="text">
            <CodeListItem CodedValue="N" OrderNumber="1">
               <Decode>
                  <TranslatedText>No</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="Y" OrderNumber="2">
               <Decode>
                  <TranslatedText>Yes</TranslatedText>
               </Decode>
            </CodeListItem>
         </CodeList>
         <CodeList OID="TIG_PIPATT"
                   Name="Tobacco Prodouct Device Event Pattern"
                   DataType="text">
            <CodeListItem CodedValue="SINGLE EVENT" OrderNumber="1">
               <Decode>
                  <TranslatedText>Single Event</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="INTERMITTENT" OrderNumber="2">
               <Decode>
                  <TranslatedText>Intermittent</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="CONTINUOUS" OrderNumber="3">
               <Decode>
                  <TranslatedText>Continuous</TranslatedText>
               </Decode>
            </CodeListItem>
         </CodeList>
      </MetaDataVersion>
