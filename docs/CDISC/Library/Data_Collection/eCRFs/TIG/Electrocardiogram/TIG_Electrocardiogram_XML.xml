            </Question>
            <Alias Name="Result" Context="prompt"/>
            <Alias Name="EGORRES" Context="SDTM"/>
            <Alias Name="Record test results, interpretations or findings."
                   Context="completionInstructions"/>
            <Alias Name="Both quantitative results and interpretive findings or summaries may be recorded here."
                   Context="implementationNotes"/>
            <Alias Name="EGHRMN_EGORRES" Context="CDASH"/>
         </ItemDef>
