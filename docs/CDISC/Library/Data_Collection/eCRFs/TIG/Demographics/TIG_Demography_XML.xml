         <ItemDef OID="DM_TIG_RACE_ASIAN" Name="ACRACE" DataType="text">
            <Question>
               <TranslatedText>Which of the following Asian racial designations best describes you? (More than 1 choice is acceptable.)</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_RACE_ASIAN_DETAILS"/>
            <Alias Name="Select each value that applies." Context="completionInstructions"/>
            <Alias Name="CRACE05-CRACE10" Context="CDASH"/>
            <Alias Name="For each value that applies, SUPPDM.QVAL where SUPPDM.QNAM =&#34;CRACEn&#34; and SUPPDM.QLABEL = &#34;Collected Race n&#34; where n is the choice value."
                   Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="DM_TIG_RACE_BAA" Name="BAACRACE" DataType="text">
            <Question>
               <TranslatedText>Which of the following black or african american racial designations best describes you? (More than 1 choice is acceptable.)</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="TIG_RACE_BLACK OR AFRICAN AMERICAN"/>
            <Alias Name="CRACE11-CRACE17" Context="CDASH"/>
            <Alias Name="Select each value that applies." Context="completionInstructions"/>
            <Alias Name="For each value that applies, SUPPDM.QVAL where SUPPDM.QNAM =&#34;CRACEn&#34; and SUPPDM.QLABEL = &#34;Collected Race n&#34; where n is the choice value."
                   Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="DM_TIG.BRTHDAT"
                  Name="BRTHDAT"
                  DataType="date"
                  SDSVarName="BRTHDTC">
            <Question>
               <TranslatedText>What is the subject's date of birth?</TranslatedText>
            </Question>
            <Alias Name="Record the date of birth to the level of precision known (e.g., day/month/year, year, month/year, etc.) in this format (DD-MON-YYYY)."
