   <Study OID="STD_20">
      <GlobalVariables>
         <StudyName>Tobacco Implementation Guide</StudyName>
         <StudyDescription/>
         <ProtocolName/>
      </GlobalVariables>
      <BasicDefinitions/>
      <MetaDataVersion OID="ODM Exports" Name="ODM Exports" Description="">
         <FormDef OID="TIG_Medical History"
                  Name="Tobacco Implementation Guide-Medical History"
                  Repeating="No">
            <Description>
               <TranslatedText xml:lang="en">This is an example Medical History CRF used to  collect verbatim descriptions of any medical conditions or events experienced by the subject.</TranslatedText>
            </Description>
            <ItemGroupRef ItemGroupOID="TIG_MH_ANY" Mandatory="Yes" OrderNumber="1"/>
            <ItemGroupRef ItemGroupOID="TIG_MH_DETAILS" Mandatory="No" OrderNumber="2"/>
         </FormDef>
         <ItemGroupDef OID="TIG_MH_ANY" Name="Any Medical History Events" Repeating="No">
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHYN"
                     Mandatory="Yes"
                     OrderNumber="1"/>
            <ItemRef ItemOID="MH_TIG_MED_HIST.MHCAT" Mandatory="No" OrderNumber="2"/>
         </ItemGroupDef>
         <ItemGroupDef OID="TIG_MH_DETAILS" Name="Medical History Events" Repeating="Yes">
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHSPIDAT"
                     Mandatory="No"
                     OrderNumber="1"/>
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHTERM"
                     Mandatory="No"
                     OrderNumber="2"/>
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHSTDAT"
                     Mandatory="No"
                     OrderNumber="3"/>
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHONGO"
                     Mandatory="No"
                     OrderNumber="4"/>
            <ItemRef ItemOID="MH_TIG_MEDICAL HISTORY.MHENDAT"
                     Mandatory="No"
                     OrderNumber="5"/>
         </ItemGroupDef>
         <ItemDef OID="MH_TIG_MED_HIST.MHCAT"
                  Name="MHCAT"
                  DataType="text"
                  Length="40"
                  SDSVarName="MHCAT">
            <Question>
               <TranslatedText>What is the category?</TranslatedText>
            </Question>
            <Alias Name="MHCAT" Context="SDTM"/>
            <Alias Name="GENERAL MEDICAL HISTIRY" Context="pre-filled"/>
            <Alias Name="MHCAT" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHENDAT"
                  Name="MHENDAT"
                  DataType="date"
                  SDSVarName="MHENDTC">
            <Description>
               <TranslatedText>MHENDAT</TranslatedText>
            </Description>
            <Question>
               <TranslatedText>What was the medical condition or event end date?</TranslatedText>
            </Question>
            <Alias Name="MHENDTC" Context="SDTM"/>
            <Alias Name="End Date" Context="prompt"/>
            <Alias Name="Record the end date of the medical event or condition using this format (DD-MON-YYYY)."
                   Context="completionInstructions"/>
            <Alias Name="MHENDAT" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHONGO"
                  Name="MHONGO"
                  DataType="text"
                  Length="8">
            <Description>
               <TranslatedText xml:lang="en">MHONGO</TranslatedText>
            </Description>
            <Question>
               <TranslatedText>Is the medical condition or event ongoing?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL_C66742_NY"/>
            <Alias Name="Ongoing (as of the [study-specific timepoint or period])"
                   Context="prompt"/>
            <Alias Name="MHENRF or MHENRTPT." Context="SDTM"/>
            <Alias Name="Record the medical condition or event as ongoing (&#34;Y&#34;) if it has not ended at the time of data collection. If the medical condition or event, is ongoing, the end date should be left blank."
                   Context="completionInstructions"/>
            <Alias Name="Completed to indicate that the condition has not resolved at the time of data collection. It is expected that every reported condition has either an End Date or the Ongoing field is populated, but not both. See Section 3.7, Mapping Relative Times from Collection to Submissions, and SDTMIG v3.2 Section 4.1.4.7 for more information."
                   Context="implementationNotes"/>
            <Alias Name="MHONGO" Context="CDASH"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHSPIDAT"
                  Name="MHSPID"
                  DataType="text"
                  Length="12"
                  SDSVarName="MHSPID">
            <Question>
               <TranslatedText>What is the medical condition or event identifier?</TranslatedText>
            </Question>
            <Alias Name="MHSPID" Context="CDASH"/>
            <Alias Name="MH Number" Context="prompt"/>
            <Alias Name="MHSPID" Context="SDTM"/>
            <Alias Name="Applicant Defined CRF Completion Instructions"
                   Context="completionInstructions"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHSTDAT"
                  Name="MHSTDAT"
                  DataType="date"
                  SDSVarName="MHSTDTC">
            <Description>
               <TranslatedText>MHSTDAT</TranslatedText>
            </Description>
            <Question>
               <TranslatedText>What was the medical event or condition start date?</TranslatedText>
            </Question>
            <Alias Name="MHSTDTC" Context="SDTM"/>
            <Alias Name="MHSTDAT" Context="CDASH"/>
            <Alias Name="Record the start date of the medical event or condition using this format (DD-MON-YYYY)."
                   Context="completionInstructions"/>
            <Alias Name="The sponsor may choose to capture a complete date or any variation thereof (e.g., month and year, year)."
                   Context="implementationNotes"/>
            <Alias Name="Start Date" Context="prompt"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHTERM"
                  Name="MHTERM"
                  DataType="text"
                  Length="8"
                  SDSVarName="MHTERM">
            <Description>
               <TranslatedText xml:lang="en">MHTERM</TranslatedText>
            </Description>
            <Question>
               <TranslatedText>What is the medical condition or event term?</TranslatedText>
            </Question>
            <Alias Name="Medical History Term" Context="prompt"/>
            <Alias Name="Record all relevant medical conditions or events, as defined in the protocol. Record only 1 medical condition or event per line. Ensure that the medical conditions or events listed on the Medical History page do not meet any of the exclusion criteria."
                   Context="completionInstructions"/>
            <Alias Name="Sponsors should collect all relevant medical conditions or events, as defined in the protocol. It is a best practice for sponsors to collect all relevant history of surgeries or procedures using the associated diagnosis in the MH domain, while reporting relevant surgeries and procedures in the SDTM PR domain. Sponsors should provide instructions on how surgeries and procedures will be handled based on the protocol requirements. Information on prespecified surgeries, or procedures should be collected in the PR domain."
                   Context="implementationNotes"/>
            <Alias Name="MHTERM" Context="CDASH"/>
            <Alias Name="MHTERM" Context="SDTM"/>
         </ItemDef>
         <ItemDef OID="MH_TIG_MEDICAL HISTORY.MHYN"
                  Name="MHYN"
                  DataType="text"
                  Length="3">
            <Description>
               <TranslatedText xml:lang="en">MHYN</TranslatedText>
            </Description>
            <Question>
               <TranslatedText>Were any medical conditions or events reported?</TranslatedText>
            </Question>
            <CodeListRef CodeListOID="CL_C66742_NY"/>
            <Alias Name="Indicate if the subject experienced any medical conditions or events. If yes, include the appropriate details where indicated on the CRF."
                   Context="completionInstructions"/>
            <Alias Name="NOT SUBMITTED" Context="SDTM"/>
            <Alias Name="Any Medical History" Context="prompt"/>
            <Alias Name="MHYN" Context="CDASH"/>
         </ItemDef>
         <CodeList OID="CL_C66742_NY" Name="No Yes Response" DataType="text">
            <CodeListItem CodedValue="N" OrderNumber="1">
               <Decode>
                  <TranslatedText>No</TranslatedText>
               </Decode>
            </CodeListItem>
            <CodeListItem CodedValue="Y" OrderNumber="2">
               <Decode>
                  <TranslatedText>Yes</TranslatedText>
               </Decode>
            </CodeListItem>
         </CodeList>
      </MetaDataVersion>
   </Study>
</ODM>
