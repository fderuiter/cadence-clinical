            "Unnamed: 7": 8,
            "Unnamed: 8": NaN,
            "Unnamed: 9": NaN,
            "Unnamed: 10": "MHTERM [en]",
            "Unnamed: 11": "MHTERM [CDASH]\nMHTERM [SDTM]\nRecord all relevant medical conditions or events, as defined in the protocol. Record only 1 medical condition or event per line. Ensure that the medical conditions or events listed on the Medical History page do not meet any of the exclusion criteria. [completionInstructions]\nSponsors should collect all relevant medical conditions or events, as defined in the protocol. It is a best practice for sponsors to collect all relevant history of surgeries or procedures using the associated diagnosis in the MH domain, while reporting relevant surgeries and procedures in the SDTM PR domain. Sponsors should provide instructions on how surgeries and procedures will be handled based on the protocol requirements. Information on prespecified surgeries, or procedures should be collected in the PR domain. [implementationNotes]\nMedical History Term [prompt]",
            "Unnamed: 12": NaN,
            "Unnamed: 13": NaN,
            "Unnamed: 14": NaN,
            "Unnamed: 15": "MHTERM",
            "Unnamed: 16": NaN,
            "Unnamed: 17": NaN,
            "Unnamed: 18": NaN,
            "Unnamed: 19": NaN,
            "Unnamed: 20": NaN,
            "Unnamed: 21": NaN
        },
        {
            "Section": "MH_TIG_MEDICAL HISTORY.MHSTDAT",
            "Unnamed: 1": "MHSTDAT",
            "Unnamed: 2": "What was the medical event or condition start date?",
            "Unnamed: 3": "date",
            "Unnamed: 4": 3,
            "Unnamed: 5": "No",
            "Unnamed: 6": NaN,
            "Unnamed: 7": NaN,
            "Unnamed: 8": NaN,
            "Unnamed: 9": NaN,
            "Unnamed: 10": "MHSTDAT",
            "Unnamed: 11": "MHSTDAT [CDASH]\nMHSTDTC [SDTM]\nRecord the start date of the medical event or condition using this format (DD-MON-YYYY). [completionInstructions]\nThe sponsor may choose to capture a complete date or any variation thereof (e.g., month and year, year). [implementationNotes]\nStart Date [prompt]",
            "Unnamed: 12": NaN,
            "Unnamed: 13": NaN,
            "Unnamed: 14": NaN,
            "Unnamed: 15": "MHSTDTC",
            "Unnamed: 16": NaN,
