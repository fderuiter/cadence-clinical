# ==========================================
# Cadence Clinical - Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secret Files
# ------------------------------------------
.env
.env.*
!.env.example
env.local
*.pem
*.key
*.crt
*.pfx
*.p12
secrets/
secrets.yaml
!.secrets.baseline

# ------------------------------------------
# Python & Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------
# Virtual Environments & Packaging
# ------------------------------------------
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!apps/web/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Testing, Linting & Coverage Tools
# ------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage/
.cadence/test_graph.json
.cadence/gxp_cache.json
nosetests.xml
coverage.xml
report.xml
report_*.xml
*.cover
*.pyo
htmlcov/
.tox/
.nox/

# ------------------------------------------
# Database & Container Persistence (Local Dev)
# ------------------------------------------
docker/postgres-data/
docker/postgres-etmf-data/
docker/postgres-ctms-data/
docker/postgres-quality-data/
docker/keycloak-data/
*.db
*.sqlite
*.sqlite3
*.log
logs/

# ------------------------------------------
