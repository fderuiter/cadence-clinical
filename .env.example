# ==============================================================================
# Cadence Clinical Research Software Platform - Environment Template
# ==============================================================================
# Copy this file to `.env.local` or `.env` for local development.
# For production and staging deployments, supply strong cryptographic secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Platform & Environment
# ------------------------------------------------------------------------------
APP_ENV=development                       # Options: development, test, staging, production
CADENCE_TEST_MODE=false                   # Set true in CI/test runs to disable external LLM/APIs
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Enterprise Branding & Domain Identity (21 CFR Part 11 / GxP)
# ------------------------------------------------------------------------------
BRAND_NAME=Cadence Clinical Research Software
BRAND_DOMAIN=ccrsoft.com

# ------------------------------------------------------------------------------
# 3. Cryptographic Secrets & Authentication Keys
# ------------------------------------------------------------------------------
# Shared HMAC-SHA256 secret for inter-service Gateway authentication headers
GATEWAY_SECRET=internal-gateway-secret-12345

# Secret key for GxP immutable audit trail hashing and verification
AUDIT_LOG_SECRET_KEY=dev-audit-secret-key-cadence-2026-secure-32b

# Secret key for eTMF inbound email verification and webhook signing
INBOUND_EMAIL_HMAC_SECRET=dev-secret-inbound-email-hmac-secure-placeholder

# Salt for Blinded/Unblinded Safety hashing (SUSAR / SAE safety reporting)
SAFETY_SALT=internal-safety-salt-12345

# Cryptographic signing secret for protocol authoring and document digital seals
SIGNING_SECRET=dev-signing-secret-key-32-bytes-long!

# Optional Redis URL for JWT/Signature replay cache
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Microservice REST Endpoints & URLs (Local Default Port Map)
# ------------------------------------------------------------------------------
GATEWAY_URL=http://localhost:8000
DESIGNER_URL=http://localhost:8001
EXECUTION_URL=http://localhost:8002
ETMF_URL=http://localhost:8003
INTEROP_URL=http://localhost:8004
QUALITY_URL=http://localhost:8005
NOTIFICATIONS_URL=http://localhost:8006
CTMS_URL=http://localhost:8007
SAFETY_URL=http://localhost:8008
TICKETS_URL=http://localhost:8009
EISF_URL=http://localhost:8010
ECONSENT_URL=http://localhost:8011
ORG_URL=http://localhost:8012

# ------------------------------------------------------------------------------
# 5. Database Connection URLs
# ------------------------------------------------------------------------------
# Neo4j Graph Database (Study Designer & USDM MDR)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cadence_password

# PostgreSQL / SQLite Storage Engines for Microservices
# Local Dev Default: SQLite | Containerized Dev: PostgreSQL
DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5432/cadence_edc
ETMF_DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5433/cadence_etmf
CTMS_DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5434/cadence_ctms
QUALITY_DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5435/cadence_quality
ORG_DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5432/cadence_edc

# SQLite services (Microservice standalone state)
SAFETY_DATABASE_URL=sqlite+aiosqlite:///safety.db
INTEROP_DATABASE_URL=sqlite+aiosqlite:///interop.db
TICKETS_DATABASE_URL=sqlite+aiosqlite:///tickets.db
NOTIFICATIONS_DATABASE_URL=sqlite+aiosqlite:///notifications.db
ECONSENT_DATABASE_URL=sqlite+aiosqlite:///econsent.db
EISF_DATABASE_URL=sqlite+aiosqlite:///eisf.db

# ------------------------------------------------------------------------------
# 6. Keycloak / OIDC Identity Provider Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cadence
KEYCLOAK_CLIENT_ID=cadence-clinical
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
JWT_ALGORITHM=RS256
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/cadence/protocol/openid-connect/certs

# ------------------------------------------------------------------------------
# 7. Notifications, SMTP & Webhooks
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev_user
SMTP_PASSWORD=dev_password
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_SENDER=no-reply@ccrsoft.com

WEBHOOK_URL=http://localhost:8006/webhooks/receiver
WEBHOOK_SIGNING_SECRET=dev_webhook_secret_key_12345
WEBHOOK_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 8. External Clinical Ontologies & Terminology Services
# ------------------------------------------------------------------------------
TERMINOLOGY_OFFLINE=false
NCI_EVS_OFFLINE=false
NCI_EVS_BASE_URL=https://api-evsrest.nci.nih.gov/api/v1
NCI_EVS_TERMINOLOGY=ncit
TERMINOLOGY_CACHE_TTL=86400

# ------------------------------------------------------------------------------
# 9. AI Digitization & LLM Ingestion (Optional)
# ------------------------------------------------------------------------------
# LLM_API_KEY=your-gemini-or-openai-api-key
# LLM_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 10. Document Storage & Archival (eTMF & eISF Artifacts)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local                     # Options: local, s3
STORAGE_LOCAL_DIR=./storage
INBOUND_EMAIL_MAX_SIZE_BYTES=10485760     # 10MB default
