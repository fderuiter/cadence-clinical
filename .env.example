# ==============================================================================
# Cadence Clinical - environment template
# ==============================================================================
# Every key below is read by the .NET code (file references in
# docs/ENVIRONMENT_VARIABLES.md). Nothing loads this file automatically: export
# it into your shell (`set -a; . ./.env; set +a`) or pass it to your IDE launch
# profile. ASP.NET Core maps `__` to `:` (ConnectionStrings__cadence ==
# ConnectionStrings:cadence).
#
# The values are local-development defaults only. Outside the Development
# environment, supply real secrets from a secret store and never reuse these.
# ==============================================================================

# ------------------------------------------------------------------------------
# Hosting
# ------------------------------------------------------------------------------
# Development enables the local database fallback and the OpenAPI/Scalar pages.
ASPNETCORE_ENVIRONMENT=Development
# Proxies (IPs or CIDR ranges) whose X-Forwarded-For/-Proto every service honours; empty trusts loopback only
CADENCE_TRUSTED_PROXIES=
# Environment guard used by the CLI's destructive `db reset` (refuses Production).
CADENCE_ENV=Development

# ------------------------------------------------------------------------------
# Database (every service with a DbContext)
# ------------------------------------------------------------------------------
# One shared database; each service works in its own schema (docs/OPERATIONAL_DATABASE.md).
# Preferred key; the Aspire AppHost injects it for you. Outside Development a
# service refuses to start when neither this nor POSTGRES_CONNECTION_STRING is set.
ConnectionStrings__cadence=Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password # pragma: allowlist secret
# Legacy flat key, still honoured after ConnectionStrings__cadence. Also read by
# the EF design-time factories (`dotnet ef migrations add`, `database update`).
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password # pragma: allowlist secret
# Fallback used by the CLI `db reset` when POSTGRES_CONNECTION_STRING is unset.
DATABASE_URL=
# Apply EF Core migrations before serving (local/single instance), or migrate and exit (deploy job).
Database__MigrateOnStartup=false
Database__MigrateOnly=false

# ------------------------------------------------------------------------------
# Execution service
# ------------------------------------------------------------------------------
# Required: Base64 AES-256 key for subject demographics encryption (32 random bytes).
# The execution service refuses to start without a valid key. Generate one with:
#   openssl rand -base64 32
DemographicsEncryption__KeyBase64=

# ------------------------------------------------------------------------------
# Notifications service (#4983)
# ------------------------------------------------------------------------------
# Optional: participant portal sign-in URL for notification links. Absolute https
# (http only on localhost). Without it, notifications carry no portal link.
Notifications__PortalUrl=
# Optional: platform name in notification footers.
Notifications__BrandName=Cadence Clinical Platform

# ------------------------------------------------------------------------------
# Field-level protection (packages/security FieldProtection, #4770)
# ------------------------------------------------------------------------------
# Payments and eConsent. Base64 AES-256-GCM key (32 random bytes) that encrypts
# payment processor references and signer e-mail addresses at rest. No default:
# those services refuse to start without a valid key. Changing it makes existing
# encrypted values unreadable. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Interop. Base64 HMAC-SHA256 key (32 random bytes) for the device-token lookup
# hashes. Must differ from FIELD_ENCRYPTION_KEY. No default: interop refuses to
# start without it. Changing it orphans every stored hash.
# Generate with: openssl rand -base64 32
FIELD_LOOKUP_HASH_KEY=

# ------------------------------------------------------------------------------
# Gateway routing (apps/gateway). Development defaults to http://localhost:<port>;
# required in any other environment.
# ------------------------------------------------------------------------------
DESIGNER_SERVICE_URL=http://localhost:8001
EXECUTION_SERVICE_URL=http://localhost:8002
ETMF_SERVICE_URL=http://localhost:8003
INTEROP_SERVICE_URL=http://localhost:8004
QUALITY_SERVICE_URL=http://localhost:8005
NOTIFICATIONS_SERVICE_URL=http://localhost:8006
CTMS_SERVICE_URL=http://localhost:8007
SAFETY_SERVICE_URL=http://localhost:8008
TICKETS_SERVICE_URL=http://localhost:8009
EISF_SERVICE_URL=http://localhost:8010
ECONSENT_SERVICE_URL=http://localhost:8011
ORG_SERVICE_URL=http://localhost:8012
FILESHARE_SERVICE_URL=http://localhost:8013
IMAGING_SERVICE_URL=http://localhost:8014
KNOWLEDGE_SERVICE_URL=http://localhost:8015
PAYMENTS_SERVICE_URL=http://localhost:8016
AI_GATEWAY_SERVICE_URL=http://localhost:8017
KERNEL_SERVICE_URL=http://localhost:8018
# Gateway timeouts and health checks (seconds; ADR-2451)
GATEWAY_PROXY_TIMEOUT_SECONDS=30
GATEWAY_HEALTH_CHECK_INTERVAL_SECONDS=10
GATEWAY_HEALTH_CHECK_TIMEOUT_SECONDS=5
# Requests per caller per minute before the gateway answers 429 (ADR-2491)
GATEWAY_RATE_LIMIT_PER_MINUTE=600

# ------------------------------------------------------------------------------
# Authentication and audit secrets
# ------------------------------------------------------------------------------
# Required by every service, at least 32 characters, no default. The gateway signs
# forwarded caller identity with it and each service verifies the signature.
GATEWAY_SECRET=local-dev-only-gateway-secret-not-for-production # pragma: allowlist secret
# Gateway only. Keycloak realm URL that issues caller tokens; required.
OIDC_AUTHORITY=http://localhost:8080/realms/cadence
# Gateway only. Internal discovery URL when the issuer is not reachable from the gateway.
OIDC_METADATA_ADDRESS=
# Gateway only. API audience only the web client's tokens carry (realm audience mapper);
# required outside Development, so tokens issued to other realm clients are refused.
OIDC_AUDIENCE=cadence-api
# Gateway only. Defaults to true; false only for a local http Keycloak.
OIDC_REQUIRE_HTTPS_METADATA=false
# Gateway only. Keycloak client (direct access grants only) used to re-check signer
# passwords for e-signatures. Defaults to cadence-esignature.
OIDC_SIGNATURE_CLIENT_ID=cadence-esignature
# Gateway only. Secret of that client, only if it is confidential.
OIDC_SIGNATURE_CLIENT_SECRET=
# Gateway only. Token endpoint override; derived from OIDC_METADATA_ADDRESS or OIDC_AUTHORITY.
OIDC_TOKEN_ENDPOINT=
# Key for GxP audit-trail digests.
AUDIT_LOG_SECRET_KEY=dev-audit-secret-key-change-me # pragma: allowlist secret
# Signer identity stamped on GxP validation signatures.
GXP_SIGNER_ID=cadence-validation-runner

# ------------------------------------------------------------------------------
# Observability (packages/telemetry)
# ------------------------------------------------------------------------------
# Set to export traces, metrics and logs over OTLP (the Aspire AppHost sets it).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Overrides the service name reported to the collector (default: assembly name).
OTEL_SERVICE_NAME=

# ------------------------------------------------------------------------------
# Tooling (packages/cli, packages/tooling_core, packages/compliance, scripts)
# ------------------------------------------------------------------------------
BRAND_DOMAIN=ccrsoft.com
# SHA256 checksum overrides for official Microsoft dotnet-install bootstrap scripts
DOTNET_INSTALL_SH_SHA256=082f7685e156738a1b2e2ed8381a621870d4ce8e8c59278034556f05c186eb2e
DOTNET_INSTALL_PS1_SHA256=e8b873e18a81e5c4cd8ab69d84dac8fead291d50b3c44633cd7fddad709a13d6
# GitHub token for `github sync` tooling (GH_TOKEN preferred over GITHUB_TOKEN).
GH_TOKEN=
GITHUB_TOKEN=
# RTM generator switches ("true" to enable).
RTM_DRAFT=
GENERATE_RTM_DRAFT=
RTM_STRICT_ALL=
# Legacy fallback read by the CLI's generic ENVIRONMENT guard.
ENVIRONMENT=

# ------------------------------------------------------------------------------
# Web apps (apps/web, apps/subject-portal). Vite reads VITE_* at build time;
# put overrides in apps/<app>/.env.local.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_BASE_PATH=/cadence-clinical/
VITE_APP_TITLE=
VITE_BRAND_NAME=Cadence Clinical Research Software
VITE_KEYCLOAK_URL=http://localhost:8080/
VITE_KEYCLOAK_REALM=cadence
VITE_KEYCLOAK_CLIENT_ID=cadence-web
# Demo build: offline demo identity, MSW mock API and sample data (same as `vite --mode demo`).
# Leave false for anything that talks to the real API; failures then show errors, never sample data.
VITE_DEMO_MODE=false
# Start the MSW mock worker without the rest of demo mode (local UI work only).
VITE_ENABLE_MSW=false
