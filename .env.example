CADENCE_DISABLE_RUNTIME_REEXEC=            # Check if auto re-execution via uv should be attempted
CADENCE_OUTCOME=                           # Source: scripts/post_pr_comment.py:632
CADENCE_TEST_MODE=false                    # Set true in CI/test runs to disable external LLM/APIs
