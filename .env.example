# ==============================================================================
# Cadence Clinical - environment template
# ==============================================================================
# Every key below is read by the .NET code (file references in
# docs/ENVIRONMENT_VARIABLES.md). Nothing loads this file automatically: export
# it into your shell (`set -a; . ./.env; set +a`) or pass it to your IDE launch
# profile. ASP.NET Core maps `__` to `:` (ConnectionStrings__cadence ==
# ConnectionStrings:cadence).
#
# The values are local-development defaults only. Outside the Development
# environment, supply real secrets from a secret store and never reuse these.
# ==============================================================================

# ------------------------------------------------------------------------------
# Hosting
# ------------------------------------------------------------------------------
# Development enables the OpenAPI/Scalar pages (there is no built-in database fallback; ADR-2260).
ASPNETCORE_ENVIRONMENT=Development
# Proxies (IPs or CIDR ranges) whose X-Forwarded-For/-Proto every service honours; empty trusts loopback only
CADENCE_TRUSTED_PROXIES=
# Environment guard used by the CLI's destructive `db reset` (refuses Production).
CADENCE_ENV=Development
# Aspire AppHost profile (`full` runs all 18 .NET hosts + web + subject-portal; `core` runs the 6 core backend hosts + web).
AppHost__Profile=full
# Optional existing OIDC issuer URL (`/realms/<realm>`) for the Aspire AppHost instead of a Keycloak container.
AppHost__OidcAuthority=

# ------------------------------------------------------------------------------
# Database (every service with a DbContext)
# ------------------------------------------------------------------------------
# One shared database; each service works in its own schema (docs/OPERATIONAL_DATABASE.md).
# Preferred key; the Aspire AppHost injects it for you. Also read first (after any
# explicit `--connection`) by CLI `db reset` / `db migrate` (`Cadence.DatabaseMigrator`),
# `cadence migrations`, and EF design-time factories (`dotnet ef`). Services and CLI
# commands refuse to run when neither this nor POSTGRES_CONNECTION_STRING is set.
ConnectionStrings__cadence=Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password # pragma: allowlist secret
# Legacy flat key, still honoured after ConnectionStrings__cadence by services,
# CLI `db reset` / `db migrate` / `cadence migrations`, and EF design-time factories (`dotnet ef`).
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password # pragma: allowlist secret
# Apply EF Core migrations before serving (local/single instance), or migrate and exit (deploy job).
Database__MigrateOnStartup=false
Database__MigrateOnly=false

# ------------------------------------------------------------------------------
# Kernel API host (apps/kernel-api)
# ------------------------------------------------------------------------------
# Development only: provisions a local kernel tenant on startup unless an active one exists (ADR-2542).
Kernel__DevelopmentTenant__Code=cadence-local
Kernel__DevelopmentTenant__Name=
# Development only (with Kernel__DevelopmentTenant__Code): seeds the demo study CADENCE-101 (ADR-2543).
Kernel__DevelopmentTenant__DemoData=true

# ------------------------------------------------------------------------------
# Intelligence module (kernel host, ADR-2630 & ADR-2636)
# ------------------------------------------------------------------------------
# Anthropic API key; empty means no Anthropic provider (there is no default key).
# Intelligence__Anthropic__ApiKey takes precedence when set.
Intelligence__Anthropic__ApiKey=
ANTHROPIC_API_KEY=
# Deterministic fake model for local work and tests; refused outside Development and Testing.
Intelligence__FakeProvider=true
# Model call timeout in seconds.
Intelligence__RequestTimeoutSeconds=120
# Standard, or LocalOnly to refuse every external model provider for every tenant (ADR-2636;
# every provider and supplier key is in docs/ENVIRONMENT_VARIABLES.md).
Intelligence__Inference__Mode=Standard
# Optional cloud/local inference provider endpoints and regions (registered only when configured).
Intelligence__Inference__Providers__AnthropicAws__Region=
Intelligence__Inference__Providers__AnthropicAws__WorkspaceId=
Intelligence__Inference__Providers__Bedrock__Region=
Intelligence__Inference__Providers__Vertex__ProjectId=
Intelligence__Inference__Providers__Vertex__Region=
Intelligence__Inference__Providers__Foundry__Resource=
Intelligence__Inference__Providers__Foundry__ApiKey=
Intelligence__Inference__Providers__OpenAiCompatible__Endpoint=
Intelligence__Inference__Providers__OpenAiCompatible__ApiKey=
# Optional named IHttpClientFactory clients permitted inside an Intelligence sandbox run.
Intelligence__Sandbox__AllowedClients__0=

# ------------------------------------------------------------------------------
# Execution service
# ------------------------------------------------------------------------------
# Required: Base64 AES-256 key for subject demographics encryption (32 random bytes).
# The execution service refuses to start without a valid key. Generate one with:
#   openssl rand -base64 32
DemographicsEncryption__KeyBase64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8= # pragma: allowlist secret
# Required: Base64 32-byte key for randomization list slots, allocations and kit arm labels (ADR-2640).
# Must differ from every other key. Generate one with: openssl rand -base64 32
RANDOMIZATION_ALLOCATION_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA= # pragma: allowlist secret
# Required: Base64 32-byte HMAC-SHA256 key for Cell & Gene Therapy vein-to-vein bag barcodes (ADR-2666).
# Must differ from every other key. Generate one with: openssl rand -base64 32
CGT_BARCODE_HMAC_KEY=AgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fICE= # pragma: allowlist secret

# ------------------------------------------------------------------------------
# Notifications service (#4983)
# ------------------------------------------------------------------------------
# Optional: participant portal sign-in URL for notification links. Absolute https
# (http only on localhost). Without it, notifications carry no portal link.
Notifications__PortalUrl=
# Optional: platform name in notification footers.
Notifications__BrandName=Cadence Clinical Platform

# ------------------------------------------------------------------------------
# Field-level protection (packages/security FieldProtection, #4770)
# ------------------------------------------------------------------------------
# Payments and eConsent. Base64 AES-256-GCM key (32 random bytes) that encrypts
# payment processor references and signer e-mail addresses at rest. No default:
# those services refuse to start without a valid key. Changing it makes existing
# encrypted values unreadable. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Interop. Base64 HMAC-SHA256 key (32 random bytes) for the device-token lookup
# hashes. Must differ from FIELD_ENCRYPTION_KEY. No default: interop refuses to
# start without it. Changing it orphans every stored hash.
# Generate with: openssl rand -base64 32
FIELD_LOOKUP_HASH_KEY=
# Interop. Base64 HMAC-SHA256 key (32 random bytes) that signs SCE database-lock
# tokens and run signature blocks. No default: interop refuses to start without
# it. Changing it invalidates every outstanding lock token.
# Generate with: openssl rand -base64 32
CADENCE_SCE_SIGNING_KEY=
# Imaging. Base64 HMAC-SHA256 key (32 random bytes) that signs de-identification
# certificates and batch manifests. No default: imaging refuses to start without
# it. Changing it makes stored certificates report an invalid signature.
# Generate with: openssl rand -base64 32
CADENCE_IMAGING_DEID_SIGNING_KEY=
# Imaging. Base64 HMAC-SHA256 key (32 random bytes) that derives anonymized DICOM
# UIDs and the original-UID hashes. Must differ from the signing key. No default.
# Changing it gives the same source study new anonymized UIDs.
# Generate with: openssl rand -base64 32
CADENCE_IMAGING_DEID_PSEUDONYMIZATION_KEY=
# Kernel and eConsent. Base64 HMAC-SHA256 key (32 random bytes) that signs and
# verifies short-lived biometric liveness tokens (ADR-2660). No default: both
# hosts refuse to start without it. Changing it invalidates active 15m tokens.
# Generate with: openssl rand -base64 32
CADENCE_BIOMETRIC_LIVENESS_KEY=

# ------------------------------------------------------------------------------
# Object storage (packages/storage, called by apps/etmf)
# ------------------------------------------------------------------------------
# Required by services calling AddCadenceStorage (`s3`, `minio`, `filesystem`, or `memory` in Development).
Storage__Provider=filesystem
# Required when Storage__Provider=filesystem (absolute directory storing `objects/` and `meta/`).
Storage__RootPath=/tmp/cadence-etmf-storage
Storage__BucketName=
Storage__Region=us-east-1
Storage__ServiceUrl=
Storage__ForcePathStyle=
Storage__ServerSideEncryption=AES256
Storage__AccessKeyId=
Storage__SecretAccessKey=

# ------------------------------------------------------------------------------
# Gateway routing (apps/gateway). Development defaults to http://localhost:<port>;
# required in any other environment.
# ------------------------------------------------------------------------------
DESIGNER_SERVICE_URL=http://localhost:8001
EXECUTION_SERVICE_URL=http://localhost:8002
ETMF_SERVICE_URL=http://localhost:8003
INTEROP_SERVICE_URL=http://localhost:8004
QUALITY_SERVICE_URL=http://localhost:8005
NOTIFICATIONS_SERVICE_URL=http://localhost:8006
CTMS_SERVICE_URL=http://localhost:8007
SAFETY_SERVICE_URL=http://localhost:8008
TICKETS_SERVICE_URL=http://localhost:8009
EISF_SERVICE_URL=http://localhost:8010
ECONSENT_SERVICE_URL=http://localhost:8011
ORG_SERVICE_URL=http://localhost:8012
FILESHARE_SERVICE_URL=http://localhost:8013
IMAGING_SERVICE_URL=http://localhost:8014
KNOWLEDGE_SERVICE_URL=http://localhost:8015
PAYMENTS_SERVICE_URL=http://localhost:8016
KERNEL_SERVICE_URL=http://localhost:8018
# Gateway timeouts and health checks (seconds; ADR-2451)
GATEWAY_PROXY_TIMEOUT_SECONDS=30
GATEWAY_HEALTH_CHECK_INTERVAL_SECONDS=10
GATEWAY_HEALTH_CHECK_TIMEOUT_SECONDS=5
# Requests per caller per minute before the gateway answers 429 (ADR-2491)
GATEWAY_RATE_LIMIT_PER_MINUTE=600

# ------------------------------------------------------------------------------
# Authentication and audit secrets
# ------------------------------------------------------------------------------
# Required by every service, at least 32 characters, no default. The gateway signs
# forwarded caller identity with it and each service verifies the signature.
GATEWAY_SECRET=local-dev-only-gateway-secret-not-for-production # pragma: allowlist secret
# Gateway only. Keycloak realm URL that issues caller tokens; required.
OIDC_AUTHORITY=http://localhost:8080/realms/cadence
# Gateway only. Internal discovery URL when the issuer is not reachable from the gateway.
OIDC_METADATA_ADDRESS=
# Gateway only. API audience only the web client's tokens carry (realm audience mapper);
# required outside Development, so tokens issued to other realm clients are refused.
OIDC_AUDIENCE=cadence-api
# Gateway only. Defaults to true; false only for a local http Keycloak.
OIDC_REQUIRE_HTTPS_METADATA=false
# Gateway only. Keycloak client (direct access grants only) used to re-check signer
# passwords for e-signatures. Defaults to cadence-esignature.
OIDC_SIGNATURE_CLIENT_ID=cadence-esignature
# Gateway only. Secret of that client, only if it is confidential.
OIDC_SIGNATURE_CLIENT_SECRET=
# Gateway only. Token endpoint override; derived from OIDC_METADATA_ADDRESS or OIDC_AUTHORITY.
OIDC_TOKEN_ENDPOINT=
# Key for GxP audit-trail digests.
AUDIT_LOG_SECRET_KEY=dev-audit-secret-key-change-me # pragma: allowlist secret
# Signer identity stamped on GxP validation signatures.
GXP_SIGNER_ID=cadence-validation-runner

# ------------------------------------------------------------------------------
# Observability (packages/telemetry)
# ------------------------------------------------------------------------------
# Set to export traces, metrics and logs over OTLP (the Aspire AppHost sets it).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Overrides the service name reported to the collector (default: assembly name).
OTEL_SERVICE_NAME=

# ------------------------------------------------------------------------------
# Tooling (packages/cli, packages/tooling_core, packages/compliance, scripts)
# ------------------------------------------------------------------------------
BRAND_DOMAIN=ccrsoft.com
# SHA256 checksum overrides for official Microsoft dotnet-install bootstrap scripts
DOTNET_INSTALL_SH_SHA256=082f7685e156738a1b2e2ed8381a621870d4ce8e8c59278034556f05c186eb2e
DOTNET_INSTALL_PS1_SHA256=e8b873e18a81e5c4cd8ab69d84dac8fead291d50b3c44633cd7fddad709a13d6
# Optional binary directory and URL/SHA-256 overrides for `cadence doctor --auto-fix` CLI linter provisioning
CADENCE_BIN_DIR=
ACTIONLINT_DOWNLOAD_URL=
ACTIONLINT_SHA256=
HADOLINT_DOWNLOAD_URL=
HADOLINT_SHA256=
SHELLCHECK_DOWNLOAD_URL=
SHELLCHECK_SHA256=
# GitHub token for `cadence rulesets` and workflow automation (GH_TOKEN preferred over GITHUB_TOKEN).
GH_TOKEN=
GITHUB_TOKEN=
# RTM generator switches ("true" to enable).
RTM_DRAFT=
GENERATE_RTM_DRAFT=
RTM_STRICT_ALL=
# PostgreSQL integration testing settings (connection string or Testcontainers switch).
CADENCE_TEST_POSTGRES=
CADENCE_TEST_DOCKER=
CADENCE_TEST_EVIDENCE_DIR=
# Opt-in 10M-edge kernel lineage benchmark ("1" to enable).
CADENCE_LINEAGE_BENCHMARK=
# Browser-to-database check of the observation correction ("1" to enable) and an optional preinstalled Chromium.
CADENCE_TEST_BROWSER=
PLAYWRIGHT_CHROMIUM_PATH=
# Subtract resolved DEID, kernel-boundary, or kernel-rule-coverage shard entries ("1" to enable).
CADENCE_UPDATE_BASELINE=
# Pre-commit authorization reason for intentional ratchet baseline growth (requires matching commit trailer).
CADENCE_BASELINE_GROWTH=
# CI environment indicators and GitHub event/ref metadata read by CLI wrappers, revision-scoped gates, and Playwright configs.
CI=
GITHUB_ACTIONS=
GITHUB_EVENT_NAME=
GITHUB_REF=
# Integration-owner switch enabling `docs/SDLC/` snapshot writes and strict RTM test mapping (ADR-2532; CI gates it on repo-owner provenance and `Gxp-Snapshot: refreshed` trailers).
CADENCE_GXP_SNAPSHOT=
# Rewrite expected USDM design import golden fixture ("1" to enable).
CADENCE_UPDATE_GOLDEN=
# Public subpath and site origin for static VitePress portal and RSS feed builds.
VITEPRESS_BASE=/cadence-clinical/
VITEPRESS_SITE_ORIGIN=https://fderuiter.github.io
# Legacy fallback read by the CLI's generic ENVIRONMENT guard.
ENVIRONMENT=

# ------------------------------------------------------------------------------
# Web apps (apps/web, apps/subject-portal). Vite reads VITE_* at build time;
# put overrides in apps/<app>/.env.local.
# ------------------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty for `pnpm --filter web dev`: the dev server then calls its own origin and its
# /api proxy forwards to CADENCE_GATEWAY_URL (default http://localhost:8000). The gateway sends no CORS headers (#5429).
VITE_API_BASE_URL=
CADENCE_GATEWAY_URL=http://localhost:8000
VITE_BASE_PATH=/cadence-clinical/
VITE_APP_TITLE=
VITE_BRAND_NAME=Cadence Clinical Research Software
VITE_KEYCLOAK_URL=http://localhost:8080/
VITE_KEYCLOAK_REALM=cadence
VITE_KEYCLOAK_CLIENT_ID=cadence-web
# Demo build: offline demo identity, MSW mock API and sample data (same as `vite --mode demo`).
# Leave false for anything that talks to the real API; failures then show errors, never sample data.
VITE_DEMO_MODE=false
# Start the MSW mock worker without the rest of demo mode (local UI work only).
VITE_ENABLE_MSW=false

# Keycloak Admin REST writeback for kernel self-service trial onboarding (fails closed with 502 if blank)
KeycloakAdmin__BaseUrl=http://localhost:8080
KeycloakAdmin__Realm=cadence
KeycloakAdmin__AdminUsername=admin
KeycloakAdmin__AdminPassword=admin

# Optional dedicated HMAC secret for signed commercial quote tokens (qtk1); defaults to Security__GatewaySecret when unset
CommercialQuote__SigningSecret=
