#!/usr/bin/env bash
# ==============================================================================
# Cadence Clinical Platform - Automated Git Pre-Commit Hook
# Validates C# code formatting, ADR integrity, and 21 GxP quality sentinels.
# Requirements: PRD-SYS-053, ADR-2233
# ==============================================================================

set -euo pipefail

# Ensure local .NET installation is in PATH
if [ -d "$HOME/.dotnet" ]; then
    export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.dotnet}"
    export PATH="$HOME/.dotnet:$HOME/.dotnet/tools:$PATH"
fi

echo "[Pre-Commit] Executing Cadence Quality Sentinels & Policy Gates..."

# Secret scanning of staged files against .secrets.baseline (issue #4765).
if command -v detect-secrets-hook >/dev/null 2>&1; then
    staged_files=()
    while IFS= read -r -d '' file; do
        staged_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)
    if [ "${#staged_files[@]}" -gt 0 ]; then
        # File exclusions come from the baseline itself; passing extra flags would rewrite it.
        detect-secrets-hook --baseline .secrets.baseline "${staged_files[@]}"
    fi
else
    echo "::warning:: detect-secrets not installed (pip install detect-secrets==1.5.0); secret scan skipped."
fi

if command -v python3 >/dev/null 2>&1 && [ -f "scripts/check-action-pinning.py" ]; then
    python3 scripts/check-action-pinning.py
fi

if command -v dotnet >/dev/null 2>&1; then
    # Format only the staged C# files; CI and 'pnpm cadence check' cover the whole solution.
    mapfile -t staged_cs < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')
    if [ "${#staged_cs[@]}" -gt 0 ]; then
        dotnet format Cadence.sln --verify-no-changes --include "${staged_cs[@]}"
    fi
    dotnet run --project packages/cli/src/Cadence.Cli.csproj -- check --pre-commit
else
    echo "::error:: .NET SDK not found. Please install .NET 10 SDK to run Cadence quality gates."
    exit 1
fi

echo "[Pre-Commit] All quality sentinels passed."
