#!/bin/sh
# ==============================================================================
# Cadence Clinical Platform - Automated Git Pre-Commit Hook
# Fail-closed POSIX launcher delegating all pre-commit guardrails to Cadence CLI.
# ==============================================================================

set -eu

WORK_ROOT=""
if command -v git >/dev/null 2>&1; then
    WORK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
if [ -z "$WORK_ROOT" ]; then
    WORK_ROOT="$(pwd)"
fi

RESOLVE_ROOT="$WORK_ROOT"
if [ ! -f "$RESOLVE_ROOT/scripts/resolve_dotnet_env.sh" ]; then
    HOOK_DIR="${0%/*}"
    if [ "$HOOK_DIR" = "$0" ]; then
        HOOK_DIR="."
    fi
    if [ -f "$HOOK_DIR/../scripts/resolve_dotnet_env.sh" ]; then
        RESOLVE_ROOT="$(CDPATH='' cd -- "$HOOK_DIR/.." && pwd)"
    fi
fi

if [ -f "$RESOLVE_ROOT/scripts/resolve_dotnet_env.sh" ]; then
    export CADENCE_RESOLVE_REPO_ROOT="$RESOLVE_ROOT"
    # shellcheck source=scripts/resolve_dotnet_env.sh
    . "$RESOLVE_ROOT/scripts/resolve_dotnet_env.sh"
    unset CADENCE_RESOLVE_REPO_ROOT
fi

if ! command -v node >/dev/null 2>&1; then
    echo "::error:: Node.js ('node') was not found on PATH. Run './scripts/setup_wizard.sh' (or './scripts/setup_wizard.ps1' on Windows) to configure required pre-commit tools." >&2
    exit 1
fi

if ! command -v dotnet >/dev/null 2>&1; then
    echo "::error:: .NET SDK ('dotnet') was not found on PATH. Install the .NET 10 SDK to run Cadence pre-commit quality gates." >&2
    exit 1
fi

cd "$WORK_ROOT"

exec node scripts/run-cli.js check --pre-commit
