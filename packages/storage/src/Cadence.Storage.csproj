<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cadence.Storage</RootNamespace>
    <Description>GxP-compliant binary and object storage abstractions, presigned URL generation, and multipart upload lifecycle management.</Description>
    <!-- No wall-clock reads (K-TIME-3): presigned URLs are dated by the AWS SDK's signing clock. -->
    <CadenceBanWallClock>true</CadenceBanWallClock>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
</Project>
