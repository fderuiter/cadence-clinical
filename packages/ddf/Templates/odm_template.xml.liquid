<?xml version="1.0" ?>
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3" FileOID="ODM.{{ study_id }}">
  <Study OID="{{ study_id }}">
    <GlobalVariables>Cadence Generated Study</GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="Version 1.0">
      {% for item in items %}
      {% if item.localizations or item.relevant or item.constraint %}
      <ItemDef OID="{{ item.id }}" Name="{{ item.name }}" DataType="{{ item.type }}">
        {% assign described = false %}
        {% for loc in item.localizations %}
        {% if loc.description != null and loc.description != "" %}{% assign described = true %}{% endif %}
        {% endfor %}
        {% if described %}
        <Description>
          {% for loc in item.localizations %}
          {% if loc.description != null and loc.description != "" %}
          <TranslatedText xml:lang="{{ loc.language }}">{{ loc.description }}</TranslatedText>
          {% endif %}
          {% endfor %}
        </Description>
        {% endif %}
        {% if item.localizations %}
        <Question>
          {% for loc in item.localizations %}
          <TranslatedText xml:lang="{{ loc.language }}">{{ loc.label }}</TranslatedText>
          {% endfor %}
        </Question>
        {% endif %}
        {% if item.relevant != null and item.relevant != "" %}
        <Alias Context="relevant" Name="{{ item.relevant }}"/>
        {% endif %}
        {% if item.constraint != null and item.constraint != "" %}
        <Alias Context="constraint" Name="{{ item.constraint }}"/>
        {% endif %}
      </ItemDef>
      {% else %}
      <ItemDef OID="{{ item.id }}" Name="{{ item.name }}" DataType="{{ item.type }}" />
      {% endif %}
      {% endfor %}
    </MetaDataVersion>
  </Study>
</ODM>
