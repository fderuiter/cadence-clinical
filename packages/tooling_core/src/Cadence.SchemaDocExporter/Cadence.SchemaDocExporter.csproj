<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cadence.SchemaDocExporter</RootNamespace>
    <Description>Writes docs/schema: the database schema of every module, rendered from its EF Core design-time model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Every service and module assembly from ServiceReferences.props plus Kernel.Persistence; Program scans referenced
       Cadence.* assemblies for IDesignTimeDbContextFactory<>. This is a build-time documentation tool, not an application,
       so K-XS-2 exempts its Kernel.Persistence reference by name (tests/Cadence.ArchitectureTests/Architecture/KernelBoundaryRules.cs). -->
  <Import Project="..\..\..\topology\ServiceReferences.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\kernel\src\Cadence.Kernel.Persistence\Cadence.Kernel.Persistence.csproj" />
    <ProjectReference Include="..\..\..\database\src\Cadence.Database.csproj" />
    <ProjectReference Include="..\..\..\topology\src\Cadence.Topology.csproj" />
    <ProjectReference Include="..\Cadence.ToolingCore.csproj" />
  </ItemGroup>

</Project>
