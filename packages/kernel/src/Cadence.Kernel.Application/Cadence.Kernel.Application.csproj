<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cadence.Kernel.Application</RootNamespace>
    <AssemblyName>Cadence.Kernel.Application</AssemblyName>
    <Description>Clinical Kernel command pipeline, authorization and policy evaluation (spec §5.1, §9.3).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Kernel.Abstractions\Cadence.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\Cadence.Kernel.Domain\Cadence.Kernel.Domain.csproj" />
    <ProjectReference Include="..\Cadence.Kernel.Modules\Cadence.Kernel.Modules.csproj" />
    <ProjectReference Include="..\Cadence.Rules\Cadence.Rules.csproj" />
    <ProjectReference Include="..\Cadence.Standards\Cadence.Standards.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.Kernel.Persistence" />
    <InternalsVisibleTo Include="Cadence.UnitTests" />
    <InternalsVisibleTo Include="Cadence.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- The module SDK's Microsoft.AspNetCore.OpenApi package brings its XML-comment source generator along, and the
       generated code references Microsoft.AspNetCore.OpenApi. The application layer maps no endpoints and must stay
       free of ASP.NET Core (spec §2.4, KernelLayeringTests), so the generator is removed here. -->
  <Target Name="RemoveOpenApiSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.AspNetCore.OpenApi'" />
    </ItemGroup>
  </Target>

</Project>
