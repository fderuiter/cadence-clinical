<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cadence.Rules</RootNamespace>
    <AssemblyName>Cadence.Rules</AssemblyName>
    <Description>Rules as versioned data (spec §10.1, K-RULE-1..4): the rule model, the expression AST, the rule-pack reader and loader, the IRuleEvaluator port with its .NET engine, and design-time conformance (the shipped pack and its runner). Depends on Cadence.Kernel.Abstractions only.</Description>
    <!-- Public API for other projects: every public member needs an XML comment (CS1591). -->
    <CadenceRequireXmlDocs>true</CadenceRequireXmlDocs>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Kernel.Abstractions\Cadence.Kernel.Abstractions.csproj" />
  </ItemGroup>

  <!-- The shipped design conformance pack is checksum-verified when it is loaded (DesignConformancePack.Sha256). -->
  <ItemGroup>
    <EmbeddedResource Include="Design\design-conformance.json" LogicalName="Cadence.Rules.Design.design-conformance.json" />
  </ItemGroup>

</Project>
