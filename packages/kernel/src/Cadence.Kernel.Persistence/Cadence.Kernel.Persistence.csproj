<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cadence.Kernel.Persistence</RootNamespace>
    <AssemblyName>Cadence.Kernel.Persistence</AssemblyName>
    <Description>Clinical Kernel persistence: EF Core 10 + Npgsql, single `kernel` schema (ADR-2247). Referenced only by the kernel API and the host (K-XS-2).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.UnitTests" />
    <InternalsVisibleTo Include="Cadence.IntegrationTests" />
    <InternalsVisibleTo Include="Cadence.TestSupport" />
    <InternalsVisibleTo Include="Cadence.ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Kernel.Abstractions\Cadence.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\Cadence.Kernel.Domain\Cadence.Kernel.Domain.csproj" />
    <ProjectReference Include="..\Cadence.Kernel.Application\Cadence.Kernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
