<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cadence.Cli</RootNamespace>
    <AssemblyName>cadence</AssemblyName>
    <Description>Native .NET 10 developer CLI and diagnostic tool for Cadence Clinical Research Software.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cadence</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine_core\src\Cadence.Core.Domain.csproj" />
    <ProjectReference Include="..\..\security\src\Cadence.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
</Project>

