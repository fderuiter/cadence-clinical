<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cadence.Cli</RootNamespace>
    <AssemblyName>cadence</AssemblyName>
    <Description>Native .NET 10 developer CLI and diagnostic tool for Cadence Clinical Research Software.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cadence</ToolCommandName>
    <PackageId>Cadence.Cli</PackageId>
    <Version>10.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine_core\src\Cadence.Core.Domain.csproj" />
    <ProjectReference Include="..\..\database\src\Cadence.Database.csproj" />
    <ProjectReference Include="..\..\compliance\src\Cadence.Compliance.csproj" />
    <ProjectReference Include="..\..\security\src\Cadence.Security.csproj" />
    <ProjectReference Include="..\..\tooling_core\src\Cadence.ToolingCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Neo4j.Driver" />
  </ItemGroup>
</Project>
