<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cadence.Testing</RootNamespace>
    <Description>Centralized test infrastructure, in-memory repository fakes, GxP requirement attributes, and factories.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine_core\src\Cadence.Core.Domain.csproj" />
    <ProjectReference Include="..\..\security\src\Cadence.Security.csproj" />
    <ProjectReference Include="..\..\kernel\src\Cadence.Kernel.Abstractions\Cadence.Kernel.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <!-- CommandValidationCatalog: finds the IValidator<TCommand> registrations of a module or the kernel. -->
    <PackageReference Include="FluentValidation" />
    <!-- TestSecurityContext.CreateSignedClient: gateway-signed clients for WebApplicationFactory hosts. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="NSubstitute" />
    <!-- MIG-SUBJ-025: GoldenMasterAssert.DbStateMatches/AuditLogContains are generic over any DbContext derived
         type rather than a concrete slice DbContext (e.g. Cadence.Apps.Execution's ExecutionDbContext),
         specifically so this shared, cross-slice package never needs a project reference to a slice's
         application assembly; see GoldenMasterAssert.cs's own remarks for the exact
         Microsoft.EntityFrameworkCore.Relational assembly version conflict build warning (documented in
         MIG-SUBJ-018's implementation sign-off) that a slice-assembly reference would reintroduce. Only the
         base EF Core abstractions are referenced here; no relational/provider package (Npgsql, Sqlite,
         InMemory) is needed by this shared library at all. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
</Project>
