<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!-- Lockstep Dependency Cohort Versions (ADR-2527) -->
    <DotNetServicingVersion>10.0.15</DotNetServicingVersion>
    <AspireHostingVersion>13.6.5</AspireHostingVersion>
    <IdentityModelVersion>8.23.0</IdentityModelVersion>
    <DotNetAiVersion>10.11.1</DotNetAiVersion>
    <!-- Stay on OpenTelemetry 1.20.x while targeting net10.0; OpenTelemetry.Api >= 1.21.0 depends on System.Diagnostics.DiagnosticSource 11.0.0 (CADDEP001, #5944, ADR-2233, ADR-2527). -->
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <OpenTelemetryInstrumentationVersion>1.20.2</OpenTelemetryInstrumentationVersion>
    <MassTransitVersion>8.5.12</MassTransitVersion>
    <FluentValidationVersion>12.2.0</FluentValidationVersion>

    <!-- Product Metadata -->
    <Company>Cadence Clinical</Company>
    <Product>Cadence Clinical Research Software Platform</Product>
    <Copyright>Copyright © 2026 Cadence Clinical. All rights reserved.</Copyright>

    <!-- GxP & Part 11 Documentation Engine Requirements -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) stays off for services, tools and tests, whose public
         members are not an API for other code. Library projects that are (the contracts package, the kernel API
         and standards assemblies) opt in with <CadenceRequireXmlDocs>true</CadenceRequireXmlDocs>; see
         Directory.Build.targets and CONTRIBUTING.md. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Global Code Analysis & Security Analyzers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" Condition="Exists('$(MSBuildThisFileDirectory)BannedSymbols.txt')" />
  </ItemGroup>
</Project>
