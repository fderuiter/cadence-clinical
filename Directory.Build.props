<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!-- Product Metadata -->
    <Company>Cadence Clinical</Company>
    <Product>Cadence Clinical Research Software Platform</Product>
    <Copyright>Copyright © 2026 Cadence Clinical. All rights reserved.</Copyright>

    <!-- GxP & Part 11 Documentation Engine Requirements -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1000;IDE0065;CA1822;CA1716;CA1710;CA1018;CA1715;CA1707;CA1859;CA1852;CS1501;CS1660;CS0103;CS0311;CS1729;CS0535</NoWarn> <!-- Missing XML comment for publicly visible type or member (temporary during initial scaffold) -->
  </PropertyGroup>

  <!-- Global Code Analysis & Security Analyzers -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>

