<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!-- Product Metadata -->
    <Company>Cadence Clinical</Company>
    <Product>Cadence Clinical Research Software Platform</Product>
    <Copyright>Copyright © 2026 Cadence Clinical. All rights reserved.</Copyright>

    <!-- GxP & Part 11 Documentation Engine Requirements -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) stays off for services, tools and tests, whose public
         members are not an API for other code. Library projects that are (the contracts package, the kernel API
         and standards assemblies) opt in with <CadenceRequireXmlDocs>true</CadenceRequireXmlDocs>; see
         Directory.Build.targets and CONTRIBUTING.md. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Global Code Analysis & Security Analyzers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- #4784 K-TIME-3 for applications: a project that sets <CadenceBanWallClock>true</CadenceBanWallClock> takes
       time only from Cadence.Kernel.Time.IClock; DateTime.Now/UtcNow and DateTimeOffset.Now/UtcNow fail the build
       (RS0030, see BannedSymbols.txt). Applications opt in as they move onto IClock; packages/kernel and tests/
       enable the same ban in their own Directory.Build.props. The condition is evaluated after the project file's
       properties, so the property can be set in the .csproj. -->
  <ItemGroup Condition="'$(CadenceBanWallClock)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>
</Project>
