{
  "name": "Cadence Clinical .NET 10 DevContainer",
  "build": {
    "dockerfile": "../docker/Dockerfile.dotnet",
    "target": "dev",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "editorconfig.editorconfig",
        "ckolkman.vscode-postgres",
        "vue.volar"
      ],
      "settings": {
        "dotnet.defaultSolution": "Cadence.slnx",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8000, 8001, 8002, 5432],
  "remoteUser": "root",
  "postCreateCommand": "bash scripts/setup_wizard.sh --dev"
}
