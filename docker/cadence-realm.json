{
  "id": "cadence",
  "realm": "cadence",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "displayName": "${env.BRAND_NAME}",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "attributes": {
    "userProfileEnabled": "true"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"study_ids\",\"displayName\":\"Study Assignments\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true},{\"name\":\"site_id\",\"displayName\":\"Site Assignments\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "Sponsor Admin",
        "description": "Sponsor Administrator with full oversight over studies."
      },
      {
        "name": "Sponsor Designer",
        "description": "Sponsor Study Designer responsible for designing and authoring study structures and eligibility criteria."
      },
      {
        "name": "CRA",
        "description": "Clinical Research Associate responsible for monitoring sites."
      },
      {
        "name": "Data Manager",
        "description": "Data Manager responsible for CDISC metadata and database locking."
      },
      {
        "name": "Site Investigator",
        "description": "Site Investigator responsible for capturing patient EDC data."
      },
      {
        "name": "Auditor",
        "description": "Auditor with read-only access to audit trails and eTMF."
      },
      {
        "name": "Monitor",
        "description": "Clinical Monitor responsible for site monitoring and data verification."
      },
      {
        "name": "Grants Manager",
        "description": "Grants Manager responsible for clinical trial budget and financial oversight."
      },
      {
        "name": "Subject",
        "description": "Subject/Patient role permitted for diary submissions, bulk sync, read assignments/instruments/compliance/notifications, and notification acknowledgements."
      },
      {
        "name": "quality_manager",
        "description": "Quality Manager responsible for CAPA review and deviation investigation."
      },
      {
        "name": "qa_lead",
        "description": "Quality Assurance Lead with full oversight of deviations and CAPAs."
      },
      {
        "name": "quality_oversight",
        "description": "Quality Oversight role with capability to approve and close CAPAs."
      }
    ]
  },
  "clients": [
    {
      "clientId": "cadence-web",
      "name": "Cadence web app",
      "description": "Browser SPA (apps/web). Public client: authorization code flow with PKCE (S256); no client secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/cadence-clinical/*",
        "http://localhost:5174/subject-portal/*",
        "http://localhost:5174/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "cadence-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "cadence-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "study assignments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "study_ids",
            "claim.name": "study_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "site assignments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "site_id",
            "claim.name": "site_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cadence-esignature",
      "name": "Cadence e-signature re-authentication",
      "description": "Used only by the gateway to re-check a signer's password before issuing an X-Sig-Token.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
