# ==============================================================================
# Cadence Clinical Research Software — .NET 10 Central Parameterized Dockerfile
# Requirements: PRD-SYS-053, ADR-2233
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Development & SDK Stage
# ------------------------------------------------------------------------------
# Base images are pinned to an exact version and digest so every build uses the same bits.
# Dependabot (.github/dependabot.yml) proposes updates; bump the SDK and runtime together.
FROM mcr.microsoft.com/dotnet/sdk:10.0.404@sha256:2b1e13a22e46b55117f9cdb4b38e73172de08a30370166c8227d06cdaff82473 AS dev

# Install curl, ffmpeg, libreoffice, git, procps for developer introspection
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libreoffice \
    git \
    procps \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install global tools in container
ENV PATH="$PATH:/root/.dotnet/tools"
RUN dotnet tool install --global dotnet-ef --version 10.0.15

WORKDIR /workspace

# Isolate container NuGet packages and MSBuild intermediates outside the /workspace bind mount
ENV NUGET_PACKAGES=/var/cache/cadence/nuget \
    UseArtifactsOutput=true \
    ArtifactsPath=/var/cache/cadence/msbuild

# Copy solution configuration files first to leverage Docker layer caching
COPY Cadence.sln Directory.Build.props Directory.Packages.props .editorconfig global.json ./

# Build arguments for target microservice application
ARG APP_NAME=gateway
ARG PROJECT_PATH=apps/${APP_NAME}/src

ENV APP_NAME=${APP_NAME}
ENV PROJECT_PATH=${PROJECT_PATH}

# ASP.NET Core listens on 8080 (the .NET 8+ container default)
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Default command for development: watch and hot-reload target project
CMD ["sh", "-c", "dotnet watch --project ${PROJECT_PATH} run"]

# ------------------------------------------------------------------------------
# 2. Build and Publish Stage
# ------------------------------------------------------------------------------
FROM dev AS build

ARG APP_NAME=gateway
ARG PROJECT_PATH=apps/${APP_NAME}/src
ARG VERSION=dev
ARG VCS_REF=unknown

COPY . .

# Restore and publish target microservice application
RUN dotnet restore ${PROJECT_PATH}
RUN dotnet publish ${PROJECT_PATH} -c Release -o /app/publish /p:UseAppHost=false /p:InformationalVersion="${VERSION}+${VCS_REF}" \
    && basename "$(ls ${PROJECT_PATH}/*.csproj)" .csproj > /app/publish/entrypoint-assembly

# ------------------------------------------------------------------------------
# 3. Production Runtime Stage
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0.15@sha256:0bfa6494dead26049c1e0d6c9dc890be79259cb7300f5f23ae1df1cdac3da7df AS runtime

# Install curl, ffmpeg, libreoffice for container health check parity and background workers
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libreoffice \
    && rm -rf /var/lib/apt/lists/*

ARG APP_NAME=gateway
ARG VERSION=dev
ARG VCS_REF=unknown
ENV APP_NAME=${APP_NAME}

LABEL org.opencontainers.image.title="cadence-${APP_NAME}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Cadence Clinical"

WORKDIR /app
USER app

COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Liveness only; orchestrators should gate traffic on /healthz/ready.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8080/healthz/live || exit 1

# The service's own assembly, recorded at publish time (a service can ship other Cadence.Apps.* assemblies).
ENTRYPOINT ["sh", "-c", "exec dotnet \"$(cat entrypoint-assembly).dll\""]
