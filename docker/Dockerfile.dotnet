# ==============================================================================
# Cadence Clinical Research Software — .NET 10 Central Parameterized Dockerfile
# Requirements: PRD-SYS-053, ADR-2233
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Development & SDK Stage
# ------------------------------------------------------------------------------
# Base images are pinned to an exact version and digest so every build uses the same bits.
# Dependabot (.github/dependabot.yml) proposes updates; bump the SDK and runtime together.
FROM mcr.microsoft.com/dotnet/sdk:10.0.404@sha256:8c6edfb26c85153f236d26efebd9ad349aec403583f343f201ee67838b23658d AS dev

# Install curl, git, procps, and netcat-traditional for developer introspection
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=8.5.0-2ubuntu10.16 \
    git=1:2.43.0-1ubuntu7.4 \
    procps=2:4.0.4-4ubuntu3.3 \
    netcat-traditional=1.10-48 \
    && rm -rf /var/lib/apt/lists/*

# Install global tools in container
ENV PATH="$PATH:/root/.dotnet/tools"
RUN dotnet tool install --global dotnet-ef --version 10.0.15

WORKDIR /workspace

# Isolate container NuGet packages and MSBuild intermediates outside the /workspace bind mount
ENV NUGET_PACKAGES=/var/cache/cadence/nuget \
    UseArtifactsOutput=true \
    ArtifactsPath=/var/cache/cadence/msbuild

# Copy root MSBuild, NuGet, SDK, and Roslyn analyzer configuration files first
COPY Cadence.sln Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.Config global.json .editorconfig BannedSymbols.txt ./

# Default environment for local dotnet-dev container (overridden per service in build/runtime)
ENV APP_NAME=gateway \
    PROJECT_PATH=apps/gateway/src \
    ASPNETCORE_HTTP_PORTS=8080

EXPOSE 8080

# Default command for development: watch and hot-reload target project
CMD ["sh", "-c", "dotnet watch --project ${PROJECT_PATH} run"]

# ------------------------------------------------------------------------------
# 2. Project Manifest Extraction Stage
# ------------------------------------------------------------------------------
# Extract only MSBuild project manifests and normalize metadata so C# source
# edits never invalidate the downstream NuGet restore cache layer.
FROM dev AS manifests

WORKDIR /tmp/context
COPY apps/ apps/
COPY packages/ packages/

RUN set -eu; \
    mkdir -p /manifests; \
    find apps packages -type f \( -name '*.csproj' -o -name 'Directory.Build.props' -o -name 'Directory.Build.targets' \) -exec cp --parents {} /manifests/ \;; \
    find /manifests -type d -exec chmod 0755 {} +; \
    find /manifests -type f -exec chmod 0644 {} +; \
    find /manifests -exec touch -h -d '2026-01-01T00:00:00Z' {} +

# ------------------------------------------------------------------------------
# 3. Shared NuGet Restore Stage
# ------------------------------------------------------------------------------
# Restore all allowlisted workspace .csproj manifests once across all 18 services.
FROM dev AS restore

COPY --from=manifests /manifests/ ./

RUN set -eu; \
    find apps packages -name '*.csproj' -print > /tmp/projs.raw; \
    sort /tmp/projs.raw > /tmp/projs.sorted; \
    printf '{\n  "solution": {\n    "path": "Cadence.sln",\n    "projects": [\n' > Cadence.docker.slnf; \
    sep=""; \
    while IFS= read -r proj; do \
      printf '%s      "%s"' "$sep" "$proj" >> Cadence.docker.slnf; \
      sep=$(printf ',\n'); \
    done < /tmp/projs.sorted; \
    printf '\n    ]\n  }\n}\n' >> Cadence.docker.slnf; \
    dotnet restore Cadence.docker.slnf; \
    rm -f Cadence.docker.slnf /tmp/projs.raw /tmp/projs.sorted

# ------------------------------------------------------------------------------
# 4. Build and Publish Stage
# ------------------------------------------------------------------------------
FROM restore AS build

ARG APP_NAME=gateway
ARG PROJECT_PATH=apps/${APP_NAME}/src
ARG VERSION=dev
ARG VCS_REF=unknown

COPY . .

# Publish target microservice application using cached restore outputs
RUN env -u VERSION dotnet publish "${PROJECT_PATH}" --no-restore -c Release -o /app/publish /p:UseAppHost=false /p:InformationalVersion="${VERSION}+${VCS_REF}" \
    && basename "$(ls "${PROJECT_PATH}"/*.csproj)" .csproj > /app/publish/entrypoint-assembly

# ------------------------------------------------------------------------------
# 5. Polyglot DevContainer Stage
# ------------------------------------------------------------------------------
# Extends `dev` with Python 3 + venv, xz-utils, SHA-256-verified Node.js 22, and
# Corepack pnpm so GitHub Codespaces / VS Code Dev Containers can run
# `scripts/setup_wizard.sh --dev` without bloating service build stages.
FROM dev AS devcontainer

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        clang=1:18.0-59~exp2 \
        python3=3.12.3-0ubuntu2.1 \
        python3-venv=3.12.3-0ubuntu2.1 \
        xz-utils=5.6.1+really5.4.5-1ubuntu0.4 \
        zlib1g-dev=1:1.3.dfsg-3.1ubuntu2.3; \
    rm -rf /var/lib/apt/lists/*; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) \
        node_arch="x64"; \
        node_sha256="sha256:cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8" ;; \
      arm64) \
        node_arch="arm64"; \
        node_sha256="sha256:2babb9eb5264860d540849f4b064a6fbdebcdc323657d9d382ce23d313fd5e09" ;; \
      *) \
        echo "Unsupported architecture: ${arch}" >&2; \
        exit 1 ;; \
    esac; \
    node_tarball="node-v22.23.5-linux-${node_arch}.tar.xz"; \
    curl -fsSL "https://nodejs.org/dist/v22.23.5/${node_tarball}" -o "/tmp/${node_tarball}"; \
    printf '%s  /tmp/%s\n' "${node_sha256#sha256:}" "${node_tarball}" > /tmp/node.sha256; \
    sha256sum -c /tmp/node.sha256; \
    tar -xJf "/tmp/${node_tarball}" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "/tmp/${node_tarball}" /tmp/node.sha256; \
    corepack enable; \
    corepack prepare pnpm@10.34.6 --activate; \
    git config --system --add safe.directory /workspace

# ------------------------------------------------------------------------------
# 6. Production Runtime Stage
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0.15@sha256:aac50ceef10391e78a899e3d2ccd00bbafa2dcb56ccf4586cbccf00edb84fc21 AS runtime

# Install curl for container health check parity
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=8.5.0-2ubuntu10.16 \
    && rm -rf /var/lib/apt/lists/*

ARG APP_NAME=gateway
ARG VERSION=dev
ARG VCS_REF=unknown
ENV APP_NAME=${APP_NAME}

LABEL org.opencontainers.image.title="cadence-${APP_NAME}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Cadence Clinical"

WORKDIR /app
USER app

COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Liveness only; orchestrators should gate traffic on /healthz/ready.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD ["curl", "-fsS", "http://localhost:8080/healthz/live"]

# The service's own assembly, recorded at publish time (a service can ship other Cadence.Apps.* assemblies).
ENTRYPOINT ["sh", "-c", "exec dotnet \"$(cat entrypoint-assembly).dll\""]
