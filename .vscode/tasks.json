{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Solution",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "Cadence.slnx"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Unit Tests",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "Cadence.slnx", "--filter", "Category!=Integration"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Integration Tests",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "Cadence.slnx", "--filter", "Category=Integration"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Format Code (Verify)",
      "command": "dotnet",
      "type": "process",
      "args": ["format", "Cadence.slnx", "--verify-no-changes"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Format Code (Fix)",
      "command": "dotnet",
      "type": "process",
      "args": ["format", "Cadence.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Sync GxP Compliance",
      "command": "python",
      "type": "process",
      "args": ["scripts/sync_gxp.py"],
      "problemMatcher": []
    },
    {
      "label": "Run Full-Stack Setup Wizard",
      "command": "bash",
      "type": "process",
      "args": ["scripts/setup_wizard.sh"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
