{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Gateway (Port 8000)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/gateway/src/Cadence.Apps.Gateway.csproj",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8000",
        "GATEWAY_SECRET": "abcdefghijklmnopqrstuvwxyz012345",
        "OIDC_AUTHORITY": "http://localhost:8080/realms/cadence",
        "OIDC_REQUIRE_HTTPS_METADATA": "false"
      }
    },
    {
      "name": "Launch Execution Engine (Port 8002)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/execution/src/Cadence.Apps.Execution.csproj",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8002",
        "ConnectionStrings__cadence": "Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password",
        "GATEWAY_SECRET": "abcdefghijklmnopqrstuvwxyz012345",
        "AUDIT_LOG_SECRET_KEY": "abcdef0",
        "DemographicsEncryption__KeyBase64": "MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE=",
        "RANDOMIZATION_ALLOCATION_KEY": "MjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjI="
      }
    },
    {
      "name": "Launch Kernel API (Port 8018)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/kernel-api/src/Cadence.Kernel.Host.csproj",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8018",
        "ConnectionStrings__cadence": "Host=localhost;Port=5432;Database=cadence;Username=cadence;Password=cadence_password",
        "GATEWAY_SECRET": "abcdefghijklmnopqrstuvwxyz012345",
        "AUDIT_LOG_SECRET_KEY": "abcdef0",
        "CADENCE_BIOMETRIC_LIVENESS_KEY": "MzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzM="
      }
    }
  ],
  "compounds": [
    {
      "name": "Core Clinical Services (Gateway + Execution + Kernel API)",
      "configurations": [
        "Launch Gateway (Port 8000)",
        "Launch Execution Engine (Port 8002)",
        "Launch Kernel API (Port 8018)"
      ]
    }
  ]
}
